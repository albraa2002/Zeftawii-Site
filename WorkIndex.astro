---
import Shell from './Shell.astro';
import Illus from './Illus.astro';
import type { Lang } from '../i18n';
import { UI, P } from '../content/ui';
import { cases } from '../content/site';
import { CONFIG } from '../config';
const { lang } = Astro.props as { lang: Lang };
const u = UI[lang]; const base = CONFIG.site.replace(/\/$/, ''); const path = P(lang, '/work/');
const title = lang === 'ar' ? 'شغل فعلي ودراسات حالة | Zeftawii' : 'Selected work and case studies | Zeftawii';
const desc = lang === 'ar' ? 'نماذج حقيقية من شغلي: نظام شغّال، 23 مشروع اتسلموا، تحليلات Python، ونموذج تجريبي. كل واحد موضّح بحالته الفعلية.' : 'Real examples of my work: a production system, 23 delivered projects, Python analyses and a prototype. Each one labeled with its real status.';
const ld = [{ '@type': 'CollectionPage', name: title, url: base + path, inLanguage: lang }];
---
<Shell lang={lang} title={title} desc={desc} path={path} alt={{ ar: '/work/', en: '/en/work/' }} extraLd={ld}>
  <div class="wrap page-head has-art"><span class="kicker">WORK</span><h1>{u.work}</h1><p>{desc}</p><div class="hb-art"><Illus kind={'bi'} /></div></div>
  <div class="wrap post-grid">
    {cases.map((c) => (
      <a class="post-card" href={P(lang, `/work/${c.slug}/`)}>
        <span class="meta">{c[lang].tag}</span>
        <h2>{c[lang].title}</h2>
        <p>{c[lang].desc}</p>
        <span class="more">{u.read} <i aria-hidden="true">{lang === 'ar' ? '←' : '→'}</i></span>
      </a>
    ))}
  </div>
</Shell>
