---
import Shell from './Shell.astro';
import PromoBanner from './PromoBanner.astro';
import Illus from './Illus.astro';
import DashShot from './DashShot.astro';
import type { Lang } from '../i18n';
import { UI, P } from '../content/ui';
import { posts } from '../content/posts';
import { services } from '../content/services';
import { CONFIG } from '../config';
import ProjectArt from './ProjectArt.astro';
import { projects } from '../content/projects';
import { tools } from '../content/tools';
import { glossary } from '../content/glossary';
import { solutions } from '../content/solutions';
const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const s = services.find((x) => x.slug === slug)!; const c = s[lang]; const u = UI[lang];
const base = CONFIG.site.replace(/\/$/, '');
const path = P(lang, `/services/${slug}/`);
const rel = posts.filter((p) => s.posts.includes(p.slug));
const others = services.filter((x) => x.slug !== slug);
const steps = u.howSteps.split('|');
const REL: Record<number, { t: string[]; g: string[]; s: string[] }> = {
  0: { t: ['business-quick-check'], g: ['kpi', 'etl', 'funnel'], s: ['woocommerce-store-analytics'] },
  1: { t: ['roas', 'break-even-calculator', 'cpa-ltv-calculator'], g: ['roas', 'cpa', 'ltv', 'break-even-roas'], s: ['salla-store-analytics', 'shopify-store-analytics', 'saudi-ecommerce-analytics', 'egypt-ecommerce-analytics'] },
  2: { t: ['automation-savings-calculator'], g: ['etl', 'kpi'], s: ['woocommerce-store-analytics'] },
  3: { t: ['cod-returns-cost-calculator', 'cpa-ltv-calculator'], g: ['rfm', 'churn-rate', 'cohort-analysis'], s: ['egypt-ecommerce-analytics'] },
  4: { t: ['business-quick-check', 'project-brief-generator'], g: ['kpi', 'sow'], s: [] },
  5: { t: ['project-brief-generator', 'business-quick-check'], g: ['sow', 'kpi'], s: [] },
};
const sampleKinds = ([['profit','accounts'],['ads','funnel'],['report','profit'],['funnel','ads'],['accounts','delivery'],['delivery','accounts']][s.idx] || ['profit','accounts']) as ('profit'|'accounts'|'ads'|'funnel'|'report'|'delivery')[];
const relProj = projects.filter((x) => x.ar.svc === slug);
const R = REL[s.idx] || { t: [], g: [], s: [] };
const relTools = R.t.map((x) => x === 'roas' ? { n: lang === 'ar' ? 'حاسبة ربحية الإعلانات (ROAS)' : 'Ad profitability calculator (ROAS)', h: P(lang, '/tools/roas-profitability-calculator/') } : { n: tools.find((y) => y.slug === x)![lang].name, h: P(lang, `/tools/${x}/`) });
const relTerms = R.g.map((x) => glossary.find((y) => y.slug === x)!).filter(Boolean);
const relSol = R.s.map((x) => solutions.find((y) => y.slug === x)!).filter(Boolean);
const wa = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent((lang === 'ar' ? 'أهلاً، حابب أستفسر عن خدمة: ' : 'Hi, I would like to ask about: ') + c.name)}`;
const ld = [
  { '@type': 'Service', name: c.name, description: c.desc, url: base + path, inLanguage: lang, provider: { '@id': `${base}/#person` }, areaServed: ['SA', 'EG'] },
  { '@type': 'FAQPage', mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: u.crumbHome, item: base + P(lang, '/') },
    { '@type': 'ListItem', position: 2, name: u.services, item: base + P(lang, '/#services') },
    { '@type': 'ListItem', position: 3, name: c.name, item: base + path },
  ] },
];
---
<Shell lang={lang} title={`${c.h1} | Zeftawii`} desc={c.desc} path={path} alt={{ ar: `/services/${slug}/`, en: `/en/services/${slug}/` }} extraLd={ld}>
  <div class="wrap svc-top">
    <nav class="crumbs" aria-label="breadcrumb"><a href={P(lang, '/')}>{u.crumbHome}</a> <span>/</span> <a href={P(lang, '/#services')}>{u.services}</a> <span>/</span> <span>{c.name}</span></nav>
    <div class="hb svc-hb" style={`--ba:${['#4c9bff', '#f59e0b', '#34d399', '#a78bfa', '#f87171', '#34d399'][s.idx] || '#4c9bff'}`}>
      <div class="hb-text">
        <span class="hb-k">{c.name}</span>
        <h1>{c.h1}</h1>
        <p>{c.lead}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={P(lang, `/?service=${s.idx}#contact`)} data-evt="cta_click" data-loc="service_page">{u.ctaBtn}</a>
          <a class="btn hb-ghost" href={wa} target="_blank" rel="noopener" data-evt="whatsapp_click" data-loc="service_page">{u.wa}</a>
        </div>
        <p class="svc-free">{u.free}</p>
      </div>
      <div class="hb-shot"><DashShot stage kind={['profit','ads','report','funnel','accounts','delivery'][s.idx] || 'profit'} lang={lang} /></div>
    </div>
  </div>
  <div class="wrap two-col">
    <section class="info-box"><h2>{u.forWho}</h2><ul>{c.forWho.map((x) => <li>{x}</li>)}</ul></section>
    <section class="info-box good"><h2>{u.get}</h2><ul>{c.get.map((x) => <li>{x}</li>)}</ul></section>
  </div>
  <div class="wrap">
    <h2 class="sec-h">{lang === 'ar' ? 'نماذج من الشغل' : 'Work samples'}</h2>
    <p class="plain">{lang === 'ar' ? 'نماذج توضيحية ببيانات تجريبية، بتبيّن شكل اللي هتستلمه. حالتك هتتبني على بياناتك أنت.' : 'Illustrative samples on sample data, showing what you would receive. Your case is built on your own data.'}</p>
    <div class="svc-samples">
      {sampleKinds.map((k) => <figure><DashShot kind={k} lang={lang} /></figure>)}
      {relProj.slice(0, 1).map((x) => <figure><a href={P(lang, `/projects/${x.slug}/`)} style="color:inherit;text-decoration:none"><ProjectArt kind={x.kind} lang={lang} name={x[lang].name} /><figcaption><b>{x[lang].name}</b>: {x[lang].hook}</figcaption></a></figure>)}
    </div>
    <h2 class="sec-h">{u.how}</h2>
    <ol class="how">{steps.map((x, i) => <li><b>{i + 1}</b><span>{x}</span></li>)}</ol>
    <h2 class="sec-h">{u.faq}</h2>
    <div class="faq-list">{c.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    <h2 class="sec-h">{lang === 'ar' ? 'مواد ذات صلة' : 'Related'}</h2>
    <div class="chips-row">
      {rel.map((p) => <a class="chip-link" href={P(lang, `/blog/${p.slug}/`)}>{p[lang].title}</a>)}
      {relTools.map((t) => <a class="chip-link" href={t.h}>{t.n}</a>)}
      {relSol.map((t) => <a class="chip-link" href={P(lang, `/solutions/${t.slug}/`)}>{t[lang].name}</a>)}
      {relTerms.map((g) => <a class="chip-link" href={P(lang, `/glossary/${g.slug}/`)}>{g[lang].term}</a>)}
    </div>
    <h2 class="sec-h">{u.moreSvc}</h2>
    <div class="chips-row">{others.map((o) => <a class="chip-link" href={P(lang, `/services/${o.slug}/`)}>{o[lang].name}</a>)}</div>
  </div>
</Shell>
