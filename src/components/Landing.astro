---
import Header from './Header.astro';
import Footer from './Footer.astro';
import DashShot from './DashShot.astro';
import { icon } from '../lib/icons';
import { UI as UIX, P as PX } from '../content/ui';
import PromoBanner from './PromoBanner.astro';
import { T, type Lang } from '../i18n';
import { chatKB } from '../chatKB';
import { SF } from '../serviceFields';
import { UI, P } from '../content/ui';
import { services as svcPages } from '../content/services';
import { posts } from '../content/posts';
import { cases } from '../content/site';
import Testimonials from './Testimonials.astro';
import TrustBar from './TrustBar.astro';
import Pledge from './Pledge.astro';
import ProjectArt from './ProjectArt.astro';
import { projects } from '../content/projects';
import HeroBanners from './HeroBanners.astro';
import { quotes } from '../content/testimonials';
import { certCount } from '../content/certs';
import { tools } from '../content/tools';
import { glossary as glossaryAll } from '../content/glossary';
import { solutions as solAll } from '../content/solutions';
import { CONFIG, hasKey, hasBooking, hasLog } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const u = UI[lang];
const wa = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(t.contact.waMsg)}`;
const chatData = {
  ...t.chat,
  logUrl: hasLog() ? CONFIG.chatLogUrl : '',
  kb: chatKB[lang],
  wa: CONFIG.whatsapp,
  waMsg: t.contact.waMsg,
  key: hasKey() ? CONFIG.web3formsKey : '',
  booking: hasBooking() ? CONFIG.bookingUrl : '',
  services: t.contact.serviceOpts,
  budgetDefault: t.contact.budgetOpts[t.contact.budgetOpts.length - 1],
  lang,
  ui: t.contact.ui,
};

const icons: Record<string, string> = {
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2" stroke-width="2" stroke-linecap="round"/>',
  target: '<circle cx="12" cy="12" r="9" stroke-width="2"/><circle cx="12" cy="12" r="4.5" stroke-width="2"/><circle cx="12" cy="12" r="1" fill="currentColor"/>',
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" stroke-width="2" stroke-linejoin="round"/>',
  users: '<circle cx="9" cy="8" r="3.5" stroke-width="2"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M16 4.8a3.5 3.5 0 0 1 0 6.4M21.5 20c0-2.8-1.6-4.7-4-5.5" stroke-width="2" stroke-linecap="round"/>',
  kanban: '<rect x="3" y="4" width="18" height="16" rx="2" stroke-width="2"/><path d="M9 8v8M15 8v5" stroke-width="2" stroke-linecap="round"/>',
  brain: '<path d="M9 4a3 3 0 0 0-3 3v1a3 3 0 0 0-2 5 3 3 0 0 0 2 5 3 3 0 0 0 6 0V4a3 3 0 0 0-3 0Zm6 0a3 3 0 0 1 3 3v1a3 3 0 0 1 2 5 3 3 0 0 1-2 5 3 3 0 0 1-6 0" stroke-width="2" stroke-linecap="round"/>',
};
const ic = (d: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
import { socialDefs } from '../lib/socials';
const w = CONFIG.whatsapp;
const phoneFmt = `+${w.slice(0, 2)} ${w.slice(2, 5)} ${w.slice(5, 8)} ${w.slice(8)}`;
const socials = Object.entries(CONFIG.links as Record<string, string>)
  .filter(([k, url]) => url && socialDefs[k])
  .map(([k, url]) => ({ ...socialDefs[k], url }));
const ar0 = lang === 'ar';
const uq = UIX[lang];
const hubN = { tools: tools.length, terms: glossaryAll.length, sols: solAll.length, posts: posts.length };
const hubFeat = [
  { h: PX(lang, '/tools/csv-data-check/'), i: 'chart', t: ar0 ? 'ارفع ملف CSV وشوف الصورة في ثواني' : 'Upload a CSV and see the picture in seconds', d: ar0 ? 'ملخص وجودة بيانات واتجاه وأعلى الفئات. الملف مبيتبعتش لأي سيرفر.' : 'Summary, data quality, trend and top categories. The file never leaves your browser.', b: ar0 ? 'جرّب الأداة' : 'Try the tool' },
  { h: PX(lang, '/find/'), i: 'tool', t: ar0 ? 'أنهي خدمة تناسبني؟' : 'Which service fits me?', d: ar0 ? '4 أسئلة وتعرف تبدأ منين.' : '4 questions and you know where to start.', b: ar0 ? 'ابدأ الاختبار' : 'Start the quiz' },
];
const hubCols = ar0 ? [
  { i: 'tool', t: 'أدوات مجانية', n: `${hubN.tools} أدوات`, h: PX(lang, '/tools/'), items: tools.slice(0, 5).map((x) => [x.ar.name, PX(lang, `/tools/${x.slug}/`)]) },
  { i: 'store', t: 'حلول للمتاجر والأسواق', n: `${hubN.sols} حلول`, h: PX(lang, '/solutions/'), items: solAll.slice(0, 5).map((x) => [x.ar.name, PX(lang, `/solutions/${x.slug}/`)]) },
  { i: 'book', t: 'تعلّم', n: `${hubN.posts} مقال و ${hubN.terms} مصطلح`, h: PX(lang, '/blog/'), items: [['المدونة', PX(lang, '/blog/')], ['قاموس المصطلحات', PX(lang, '/glossary/')], ['قوالب مجانية', PX(lang, '/resources/')], ['الأسئلة الشائعة', PX(lang, '/faq/')]] },
] : [
  { i: 'tool', t: 'Free tools', n: `${hubN.tools} tools`, h: PX(lang, '/tools/'), items: tools.slice(0, 5).map((x) => [x.en.name, PX(lang, `/tools/${x.slug}/`)]) },
  { i: 'store', t: 'Store and market solutions', n: `${hubN.sols} solutions`, h: PX(lang, '/solutions/'), items: solAll.slice(0, 5).map((x) => [x.en.name, PX(lang, `/solutions/${x.slug}/`)]) },
  { i: 'book', t: 'Learn', n: `${hubN.posts} articles, ${hubN.terms} terms`, h: PX(lang, '/blog/'), items: [['Blog', PX(lang, '/blog/')], ['Glossary', PX(lang, '/glossary/')], ['Free templates', PX(lang, '/resources/')], ['FAQ', PX(lang, '/faq/')]] },
];
---
<a class="skip" href="#main">{t.skip}</a>

<Header lang={lang} alt={t.switchHref} />

<main id="main">
  <div class="hero" id="top">
   <div class="hero-band" data-df>
    <canvas class="df" aria-hidden="true"></canvas>
    <div class="df-read" aria-hidden="true"><b data-df-read>0</b><span>{ar0 ? '% إشارة من الضجيج' : '% signal out of noise'}</span></div>
    <div class="wrap hs" data-hs aria-roledescription="carousel" aria-label={ar0 ? 'عروض الصفحة الرئيسية' : 'Homepage highlights'}>
      <div class="hs-track" aria-live="off"><HeroBanners lang={lang} t={t} /></div>
      <div class="hs-ctl">
        <button type="button" class="hs-btn" data-hs-prev aria-label={ar0 ? 'السابق' : 'Previous'}>{ar0 ? '›' : '‹'}</button>
        <div class="hs-dots" style="display:flex;gap:.4rem">{[0, 1, 2, 3].map((i) => <button type="button" class={`hs-dot${i === 0 ? ' on' : ''}`} data-hs-go={i} aria-label={`${i + 1} / 4`}></button>)}</div>
        <button type="button" class="hs-btn" data-hs-next aria-label={ar0 ? 'التالي' : 'Next'}>{ar0 ? '‹' : '›'}</button>
        <button type="button" class="hs-btn hs-pp" data-hs-pp aria-pressed="false">{ar0 ? 'إيقاف التبديل' : 'Pause'}</button>
      </div>
    </div>
   </div>
    <div class="wrap">
      <div class="stats rv">{t.stats.map((s) => <div class="stat"><b>{s.v}</b><span>{s.l}</span></div>)}</div>
      <TrustBar lang={lang} />
    </div>
  </div>

  <section id="services">
    <div class="wrap">
      <div class="sec-head rv"><h2>{t.servicesTitle}</h2><p>{t.servicesSub}</p></div>
      <div class="carousel rv" data-carousel>
        <div class="track" tabindex="0" role="region" aria-roledescription="carousel" aria-label={t.servicesTitle}>
        {t.services.map((s, i) => (
          <article class="card">
            <div class="ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" set:html={icons[s.icon]} /></div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <ul>{s.pts.map((p) => <li>{p}</li>)}</ul>
            <a class="card-cta" href="#contact" data-service={i} data-evt="service_click" data-loc={s.icon}>{t.serviceCta}<span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span></a>
            {svcPages.find((x) => x.idx === i) && <a class="card-more" href={P(lang, `/services/${svcPages.find((x) => x.idx === i)!.slug}/`)}>{lang === 'ar' ? 'تفاصيل الخدمة' : 'Service details'}</a>}
          </article>
        ))}
        </div>
        <div class="car-ctrl">
          <button type="button" class="car-btn" data-dir="prev" aria-label={lang === 'ar' ? 'السابق' : 'Previous'}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
          </button>
          <div class="car-dots"></div>
          <button type="button" class="car-btn" data-dir="next" aria-label={lang === 'ar' ? 'التالي' : 'Next'}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="sec-head rv"><h2>{ar0 ? 'مشاريع بنيتها بإيدي' : 'Projects I built myself'}</h2><p>{ar0 ? 'أمثلة تحليلية على GitHub. كل مشروع بيحل مشكلة واحدة، ومكتوب بوضوح لما البيانات تجريبية.' : 'Analytics examples on GitHub. Each solves one problem, and simulated data is labelled clearly.'}</p></div>
      <div class="carousel proj-car rv" data-carousel>
        <div class="track" tabindex="0" role="region" aria-roledescription="carousel" aria-label={ar0 ? 'مشاريع' : 'Projects'}>
        {projects.filter((x) => x.featured).slice(0, 3).map((x) => (
          <a class="post-card proj-card" href={P(lang, `/projects/${x.slug}/`)}>
            <ProjectArt kind={x.kind} lang={lang} name={x[lang].name} />
            <h3>{x[lang].name}</h3><p>{x[lang].hook}</p>
          </a>
        ))}
        </div>
        <div class="car-ctrl">
          <button type="button" class="car-btn" data-dir="prev" aria-label={ar0 ? 'السابق' : 'Previous'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg></button>
          <div class="car-dots"></div>
          <button type="button" class="car-btn" data-dir="next" aria-label={ar0 ? 'التالي' : 'Next'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></button>
        </div>
      </div>
      <p class="work-more rv"><a class="btn btn-ghost" href={P(lang, '/projects/')}>{ar0 ? 'كل المشاريع' : 'All projects'}</a><a class="btn btn-ghost" href={P(lang, '/work/')}>{ar0 ? 'دراسات الحالة' : 'Case studies'}</a></p>
    </div>
  </section>

  <section id="free">
    <div class="wrap">
      <div class="sec-head rv"><h2>{ar0 ? 'كل ده مجاني، جرّبه قبل ما تتواصل' : 'All of this is free. Try it before you get in touch'}</h2><p>{ar0 ? 'أدوات وحلول ومحتوى بنيتهم من شغل فعلي. مفيش تسجيل ومفيش بطاقة.' : 'Tools, solutions and content built from real work. No sign-up and no card.'}</p></div>
      <div class="fh-feat rv">
        {hubFeat.map((x, i) => (
          <a class={`fh-hero${i === 0 ? ' main' : ''}`} href={x.h} data-evt="cta_click" data-loc="home_free">
            <span class="fh-ic" set:html={icon(x.i, 26)}></span>
            <span class="fh-tx"><b>{x.t}</b><small>{x.d}</small></span>
            <span class="fh-go">{x.b}</span>
          </a>
        ))}
      </div>
      <div class="fh-cols rv">
        {hubCols.map((c) => (
          <div class="fh-col">
            <div class="fh-h"><span set:html={icon(c.i, 20)}></span><b>{c.t}</b><em>{c.n}</em></div>
            <ul>{c.items.map((it) => (<li><a href={it[1]}>{it[0]}</a></li>))}</ul>
            <a class="fh-all" href={c.h}>{ar0 ? 'شوف الكل' : 'See all'}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="calc">
    <div class="wrap">
      <div class="sec-head rv"><h2>{ar0 ? 'أدوات مجانية تجرّبها بنفسك' : 'Free tools you can try yourself'}</h2><p>{ar0 ? 'حاسبات وفحوصات سريعة. اختار الأداة، اكتب أرقامك، وخد تقرير قصير فيه نصيحة.' : 'Quick calculators and checks. Pick a tool, enter your numbers and get a short report with advice.'}</p></div>
      <div class="carousel tool-car rv" data-carousel>
        <div class="track" tabindex="0" role="region" aria-roledescription="carousel" aria-label={ar0 ? 'الأدوات المجانية' : 'Free tools'}>
          {tools.map((x, i) => (
            <a class="post-card tool-card" href={P(lang, `/tools/${x.slug}/`)}>
              <span class="tool-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="meta">{x.kind === 'check' ? (ar0 ? 'فحص سريع' : 'QUICK CHECK') : x.kind === 'csv' ? (ar0 ? 'فحص ملف' : 'FILE CHECK') : x.kind === 'brief' ? (ar0 ? 'مولّد' : 'GENERATOR') : (ar0 ? 'حاسبة' : 'CALCULATOR')}</span>
              <h3>{x[lang].name}</h3>
              <p>{x[lang].desc}</p>
              <span class="more">{ar0 ? 'جرّب الأداة' : 'Try the tool'} <i aria-hidden="true">{ar0 ? '←' : '→'}</i></span>
            </a>
          ))}
        </div>
        <div class="car-ctrl">
          <button type="button" class="car-btn" data-dir="prev" aria-label={ar0 ? 'السابق' : 'Previous'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg></button>
          <div class="car-dots"></div>
          <button type="button" class="car-btn" data-dir="next" aria-label={ar0 ? 'التالي' : 'Next'}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></button>
        </div>
      </div>
      <p class="work-more rv"><a class="btn btn-ghost" href={P(lang, '/tools/')}>{ar0 ? 'كل الأدوات' : 'All tools'}</a></p>
    </div>
  </section>

  <section id="voices">
    <div class="wrap">
      <div class="sec-head rv"><h2>{lang === 'ar' ? 'بيقولوا إيه عن الشغل' : 'What people say'}</h2><p>{lang === 'ar' ? 'آراء حقيقية من عملاء ومديرين وزملاء — بالدور فقط، بدون أسماء.' : 'Real feedback from clients, managers and teammates — by role only, no names.'}</p></div>
      <Testimonials lang={lang} />
    </div>
  </section>


  <section id="faq">
    <div class="wrap" style="max-width: 820px">
      <div class="sec-head rv"><h2>{t.faqTitle}</h2></div>
      {t.faq.map((f) => <details class="rv"><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <Pledge lang={lang} />

  <section id="contact">
    <div class="wrap contact-grid">
      <div class="rv">
        <div class="sec-head"><h2>{t.contact.title}</h2><p>{t.contact.sub}</p></div>
        <div class="contact-side">
          <a class="btn btn-wa" href={wa} target="_blank" rel="noopener" data-evt="whatsapp_click" data-loc="contact">{t.contact.wa}</a>
          {hasBooking() && <a class="btn btn-ghost" href={CONFIG.bookingUrl} target="_blank" rel="noopener" data-evt="booking_click" data-loc="contact">{t.contact.book}</a>}
          <a class="btn btn-ghost" href={`mailto:${CONFIG.email}`} style="direction:ltr" data-evt="email_click" data-loc="contact">{CONFIG.email}</a>
          <p class="assure">{t.contact.assure}</p>
        </div>
        <div class="fhelp" id="fhelp" data-sf={JSON.stringify(SF[lang])} data-prep={t.help.prepT} data-get={t.help.getT}>
          <div class="fh-dyn" id="fh-dyn" aria-live="polite"></div>
          <div class="fh-box">
            <h3>{t.help.stepsT}</h3>
            <ol class="fh-steps">{t.help.steps.map((x) => <li>{x}</li>)}</ol>
            <p class="fh-tip">{t.help.tip}</p>
          </div>
        </div>
      </div>

      <form id="lead" class="form rv" novalidate
        data-key={hasKey() ? CONFIG.web3formsKey : ''}
        data-wa={CONFIG.whatsapp}
        data-lang={lang} data-ui={JSON.stringify(t.contact.ui)} data-sf={JSON.stringify(SF[lang])} data-opt={lang === 'ar' ? 'اختار (اختياري)' : 'Choose (optional)'}
        data-ok={t.contact.ok} data-err={t.contact.err} data-req={t.contact.required} data-sending={t.contact.sending}>
        <input type="text" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="row2">
          <label>{t.contact.name}<input name="name" required aria-required="true" autocomplete="name" /></label>
          <label>{t.contact.phone}<input name="phone" inputmode="tel" autocomplete="tel" dir="ltr" /></label>
        </div>
        <label>{t.contact.email}<input name="email" type="email" autocomplete="email" dir="ltr" /></label>
        <div class="row2">
          <label>{t.contact.service}
            <select name="service">{t.contact.serviceOpts.map((o) => <option>{o}</option>)}</select>
          </label>
          <label>{t.contact.budget}
            <select name="budget">{t.contact.budgetOpts.map((o) => <option>{o}</option>)}</select>
          </label>
        </div>
        <p class="svc-hint" id="svc-hint"></p>
        <div class="row2 svc-fields" id="svc-fields"></div>
        <label><span id="msg-l">{t.contact.msg}</span><textarea name="message" placeholder={t.contact.msgPh} required aria-required="true"></textarea></label>
        <button class="btn btn-primary" type="submit">{t.contact.send}</button>
        <p class="form-note">{lang === 'ar' ? 'بستخدم بياناتك للرد عليك بس. ' : 'Your details are used only to reply to you. '}<a href={P(lang, '/privacy/')}>{lang === 'ar' ? 'سياسة الخصوصية' : 'Privacy policy'}</a></p>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</main>

<Footer lang={lang} band={false} />

<a class="wa-float" href={wa} target="_blank" rel="noopener" aria-label={t.contact.wa} data-evt="whatsapp_click" data-loc="float">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.2c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.4-3.9-4.5-4.1-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9.9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.300 1.700 2.100 1.200 1 2.200 1.400 2.500 1.500.3.1.5.1.7-.1.200-.200.800-.900 1-1.200.2-.3.400-.3.700-.2l1.900.9c.3.100.5.200.6.300.1.200.1.800-.1 1.400Z"/></svg>
</a>

<button type="button" class="chat-launcher" id="chat-open" aria-expanded="false" aria-controls="chat-panel" aria-label={t.chat.open} data-evt="chat_open" data-loc="launcher">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.5-4.6A8 8 0 1 1 21 12Z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01" stroke-width="2.6"/></svg>
</button>

<section class="chat" id="chat-panel" role="dialog" aria-label={t.chat.title} hidden>
  <header class="chat-head">
    <img src="/albaraa-320.jpg" width="40" height="40" alt="" />
    <div><b>{t.chat.title}</b><small>{t.chat.status}</small></div>
    <button type="button" class="chat-x" id="chat-close" aria-label={t.chat.close}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </header>
  <div class="chat-log" id="chat-log" role="log" aria-live="polite"></div>
  <form class="chat-form" id="chat-form" autocomplete="off">
    <input id="chat-input" type="text" maxlength="400" placeholder={t.chat.placeholder} aria-label={t.chat.placeholder} />
    <button type="submit" class="chat-send" aria-label={t.chat.send}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z"/></svg>
    </button>
  </form>
  <p class="chat-note">{t.chat.note}{hasLog() ? (lang === 'ar' ? ' الأسئلة بتتسجل من غير اسم لتحسين الردود، فمتكتبش بيانات حساسة.' : ' Questions are logged anonymously to improve answers, so please avoid sensitive data.') : ''}</p>
</section>
<script type="application/json" id="chat-data" is:inline set:html={JSON.stringify(chatData)} />

<script>
  import { toLatinDigits, getCtx, makeRef, cleanPhone, validPhone, validEmail, stripHtml, validate, waText, waLink, enrichWaClick, throttle, submitLead, noteSentViaWa, type Lead } from '../lib/lead';
  import { initCarousels } from '../lib/carousel';
  import { initDecode } from '../lib/decode';
  getCtx();
  initCarousels();
  document.querySelectorAll<HTMLElement>('[data-df]').forEach(initDecode);

  document.querySelectorAll<HTMLElement>('[data-hs]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.hs-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.hs-dot'));
    const pp = root.querySelector('[data-hs-pp]') as HTMLButtonElement;
    const ms = 7000; root.style.setProperty('--hs-ms', ms + 'ms');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, timer = 0, paused = reduce, hover = false;
    const labels = pp.textContent!.includes('إيقاف') ? ['إيقاف التبديل', 'تشغيل التبديل'] : ['Pause', 'Play'];
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => { s.classList.toggle('on', k === i); s.setAttribute('aria-hidden', String(k !== i)); s.querySelectorAll<HTMLElement>('a,button').forEach((x) => (x.tabIndex = k === i ? 0 : -1)); });
      dots.forEach((d, k) => { d.classList.remove('on'); if (k === i) { void d.offsetWidth; d.classList.add('on'); } });
      arm();
    };
    const arm = () => { clearTimeout(timer); root.classList.toggle('run', !paused && !hover); if (!paused && !hover) timer = window.setTimeout(() => show(i + 1), ms); };
    const setPaused = (p: boolean) => { paused = p; pp.setAttribute('aria-pressed', String(p)); pp.textContent = p ? labels[1] : labels[0]; arm(); };
    dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
    (root.querySelector('[data-hs-prev]') as HTMLElement).addEventListener('click', () => show(i - 1));
    (root.querySelector('[data-hs-next]') as HTMLElement).addEventListener('click', () => show(i + 1));
    pp.addEventListener('click', () => setPaused(!paused));
    root.addEventListener('mouseenter', () => { hover = true; arm(); }); root.addEventListener('mouseleave', () => { hover = false; arm(); });
    root.addEventListener('focusin', () => { hover = true; arm(); }); root.addEventListener('focusout', () => { hover = false; arm(); });
    document.addEventListener('visibilitychange', () => { hover = document.hidden; arm(); });
    let x0 = 0; root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(i + (dx < 0 ? 1 : -1) * (document.documentElement.dir === 'rtl' ? -1 : 1)); }, { passive: true });
    slides.forEach((s, k) => s.querySelectorAll<HTMLElement>('a,button').forEach((x) => (x.tabIndex = k === 0 ? 0 : -1)));
    pp.textContent = paused ? labels[1] : labels[0]; pp.setAttribute('aria-pressed', String(paused)); arm();
  });

  const trk = (name: string, params: Record<string, unknown> = {}) => {
    const g = (window as any).gtag;
    if (typeof g === 'function') g('event', name, { lang: document.documentElement.lang, ...params });
  };
  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest<HTMLElement>('[data-evt]');
    if (el) trk(el.dataset.evt!, { location: el.dataset.loc });
    const sv = (e.target as Element).closest<HTMLElement>('[data-service]');
    if (sv) {
      const sel = document.querySelector<HTMLSelectElement>('#lead select[name="service"]');
      if (sel) { sel.selectedIndex = Number(sv.dataset.service); sel.dispatchEvent(new Event('change', { bubbles: true })); }
    }
  });


  // ===== المساعد الآلي (rule-based، من غير سيرفر) =====
  (() => {
    const raw = document.getElementById('chat-data');
    const panel = document.getElementById('chat-panel') as HTMLElement | null;
    const launcher = document.getElementById('chat-open') as HTMLButtonElement | null;
    if (!raw || !panel || !launcher) return;
    const D = JSON.parse(raw.textContent || '{}');
    const log = document.getElementById('chat-log') as HTMLElement;
    const formEl = document.getElementById('chat-form') as HTMLFormElement;
    const input = document.getElementById('chat-input') as HTMLInputElement;
    const closeBtn = document.getElementById('chat-close') as HTMLButtonElement;

    const norm = (s: string) => s.toLowerCase()
      .replace(/[ً-ٰٟـ]/g, '').replace(/[إأآٱ]/g, 'ا').replace(/ى/g, 'ي').replace(/ة/g, 'ه')
      .replace(/[^\p{L}\p{N}\s]/gu, ' ').replace(/\s+/g, ' ').trim();
    const prep = (s: string) => norm(s).split(' ').filter(Boolean).map((w) => (w.startsWith('ال') && w.length > 4 ? w.slice(2) : w));
    const kn: Record<string, { w: string; short: boolean }[]> = {};
    D.kb.entries.forEach((e: any) => {
      kn[e.id] = (e.k as string[]).map((k) => { const w = prep(k).join(' '); return { w, short: w.length <= 3 && !w.includes(' ') }; });
    });
    const match = (text: string) => {
      const toks = prep(text); const joined = ' ' + toks.join(' ') + ' ';
      let best: any = null, bs = 0;
      for (const e of D.kb.entries) {
        let sc = 0;
        for (const k of kn[e.id] || []) if (k.short ? toks.includes(k.w) : joined.includes(k.w)) sc += k.w.length;
        if (sc > bs) { bs = sc; best = e; }
      }
      return best;
    };

    const trk = (name: string, p: Record<string, unknown> = {}) => {
      const g = (window as any).gtag; if (typeof g === 'function') g('event', name, { lang: D.lang, ...p });
    };
    const sid = Math.random().toString(36).slice(2, 10);
    const redact = (x: string) => x.replace(/[\w.+-]+@[\w-]+\.[\w.]+/g, '[email]').replace(/\+?\d[\d\s-]{6,}\d/g, '[num]').slice(0, 200);
    const logEv = (type: string, data: Record<string, unknown> = {}) => {
      if (!D.logUrl) return;
      try { fetch(D.logUrl, { method: 'POST', mode: 'no-cors', keepalive: true, body: JSON.stringify({ t: type, sid, lang: D.lang, ...data }) }).catch(() => {}); } catch {}
    };
    const scroll = () => { log.scrollTop = log.scrollHeight; };
    const el = (tag: string, cls?: string, text?: string) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text) n.textContent = text; return n; };

    let step: '' | 'name' | 'contact' | 'service' | 'msg' = '';
    const lead: Record<string, string> = {};
    let busy = false;

    const clearChips = () => log.querySelectorAll('.chat-opts').forEach((n) => n.remove());
    const user = (text: string) => { const m = el('div', 'msg me', text); log.appendChild(m); scroll(); };
    const typing = () => { const t = el('div', 'msg bot typing'); t.innerHTML = '<i></i><i></i><i></i>'; t.setAttribute('aria-hidden', 'true'); log.appendChild(t); scroll(); return t; };

    const bot = (text: string, opts: { chips?: string[]; links?: { l: string; h: string }[]; act?: string[]; wait?: boolean; fb?: { id: string; q: string } } = {}) => {
      const t = typing();
      const delay = opts.wait === false ? 0 : Math.min(900, 280 + text.length * 6);
      return new Promise<void>((res) => setTimeout(() => {
        t.remove();
        log.appendChild(el('div', 'msg bot', text));
        const box = el('div', 'chat-opts');
        (opts.chips || []).forEach((c) => {
          const b = el('button', 'chip-btn', c); b.type = 'button';
          b.addEventListener('click', () => ask(c)); box.appendChild(b);
        });
        (opts.links || []).forEach((x) => { const a = el('a', 'act-btn', x.l) as HTMLAnchorElement; a.href = x.h; a.target = '_blank'; a.rel = 'noopener'; box.appendChild(a); });
        (opts.act || []).forEach((a) => {
          if (a === 'lead') { const b = el('button', 'act-btn', D.actLead); b.type = 'button'; b.addEventListener('click', startLead); box.appendChild(b); }
          if (a === 'wa') { const x = el('a', 'act-btn wa', D.actWa) as HTMLAnchorElement; x.href = `https://wa.me/${D.wa}?text=${encodeURIComponent(D.waMsg)}`; x.target = '_blank'; x.rel = 'noopener'; x.dataset.evt = 'whatsapp_click'; x.dataset.loc = 'chat'; box.appendChild(x); }
          if (a === 'book' && D.booking) { const x = el('a', 'act-btn', D.actBook) as HTMLAnchorElement; x.href = D.booking; x.target = '_blank'; x.rel = 'noopener'; x.dataset.evt = 'booking_click'; x.dataset.loc = 'chat'; box.appendChild(x); }
        });
        if (opts.fb) {
          const f = opts.fb; const row = el('div', 'fb');
          const ar = D.lang === 'ar';
          const lab = el('span', 'fb-l', ar ? 'الرد فادك؟' : 'Helpful?'); row.appendChild(lab);
          ([['up', '👍'], ['down', '👎']] as const).forEach(([k, ic]) => {
            const b = el('button', 'fb-b', ic); b.type = 'button'; b.setAttribute('aria-label', k === 'up' ? (ar ? 'مفيد' : 'Helpful') : (ar ? 'مش مفيد' : 'Not helpful'));
            b.addEventListener('click', () => {
              logEv('fb', { v: k, id: f.id, q: f.q }); row.textContent = ar ? 'شكراً على رأيك 🙏' : 'Thanks for the feedback 🙏';
              if (k === 'down') bot(ar ? 'آسف إن الرد مكانش كفاية. لو سيبت بياناتك البراء هيرد عليك بنفسه.' : 'Sorry that did not help. Leave your details and Albaraa will reply personally.', { act: ['lead', 'wa'], wait: false });
            });
            row.appendChild(b);
          });
          log.appendChild(row);
        }
        if (box.childElementCount) log.appendChild(box);
        scroll(); res();
      }, delay));
    };

    const startLead = async () => {
      clearChips(); step = 'name'; trk('chat_lead_start');
      input.placeholder = D.askName;
      await bot(D.askName, { act: [] });
      input.focus();
    };

    // ---------- جلسات الاستشارة الموجّهة (ستاتيك) ----------
    let topic = '';
    const userMsgs: string[] = [];
    let preset = ''; let details: [string, string][] = [];
    type Fl = { f: any; i: number; picks: { q: string; l: string; t: string }[] };
    let fl: Fl | null = null;
    const flowChips = (f: any, i: number) => {
      const c = f.steps[i].o.map((o: any) => o.l);
      if (i > 0) c.push(D.kb.flowBack);
      c.push(D.kb.flowCancel); return c;
    };
    const flowAsk = async () => { if (fl) await bot(fl.f.steps[fl.i].q, { chips: flowChips(fl.f, fl.i) }); };
    const flowStart = async (id: string) => {
      const f = D.kb.flows.find((x: any) => x.id === id); if (!f) return;
      fl = { f, i: 0, picks: [] }; topic = id === 'any' ? '' : id; trk('chat_flow_start', { flow: id });
      await bot(f.intro, { wait: true }); await flowAsk();
    };
    const flowFinish = async () => {
      if (!fl) return; const f = fl.f; const picks = fl.picks; fl = null;
      preset = D.services[f.svc] || ''; details = picks.map((p) => [p.q.replace(/[؟?:\s]+$/, ''), p.l] as [string, string]);
      trk('chat_flow_done', { flow: f.id }); logEv('flow', { id: f.id, picks: picks.map((p) => p.l).join(' | ').slice(0, 200) });
      await bot(f.intro + '\n\n' + picks.map((p) => '• ' + p.t).join('\n') + '\n\n' + f.outro, { act: ['lead', 'wa'] });
    };
    const flowStep = async (text: string) => {
      if (!fl) return; const n = norm(text);
      if (n === norm(D.kb.flowCancel)) { fl = null; await bot(D.kb.menuIntro || D.hello, { chips: D.kb.menu }); return; }
      if (n === norm(D.kb.flowBack)) { fl.i = Math.max(0, fl.i - 1); fl.picks.length = fl.i; await flowAsk(); return; }
      const st = fl.f.steps[fl.i];
      let opt = st.o.find((o: any) => norm(o.l) === n);
      if (!opt && n.length > 2) opt = st.o.find((o: any) => norm(o.l).includes(n) || (n.includes(norm(o.l)) && norm(o.l).length > 3));
      if (!opt) { await bot(D.kb.flowPick, { chips: flowChips(fl.f, fl.i), wait: false }); return; }
      fl.picks[fl.i] = { q: st.q, l: opt.l, t: opt.t }; fl.i++;
      if (fl.i >= fl.f.steps.length) await flowFinish(); else await flowAsk();
    };

    const finishLead = async () => {
      busy = true; input.disabled = true;
      const msg = (lead.msg || '') + (userMsgs.length ? `\n\n[${D.lang === 'ar' ? 'من محادثة الشات' : 'From chat'}]\n${userMsgs.slice(-4).map((m) => '- ' + m).join('\n').slice(0, 700)}` : '');
      const isMail = lead.contact.includes('@');
      const L: Lead = { name: stripHtml(lead.name), phone: isMail ? '' : cleanPhone(lead.contact), email: isMail ? lead.contact.trim() : '', service: lead.service, budget: D.budgetDefault, message: msg.trim(), source: 'chatbot', details };
      const ref = makeRef();
      await bot(D.sending, { wait: false });
      const waBox = (label: string, loc: string) => {
        const box = el('div', 'chat-opts');
        const x = el('a', 'act-btn wa', label) as HTMLAnchorElement;
        x.href = waLink(D.wa, waText(D.lang, L, ref)); x.target = '_blank'; x.rel = 'noopener'; x.dataset.evt = 'whatsapp_click'; x.dataset.loc = loc;
        x.addEventListener('click', () => noteSentViaWa(L));
        box.appendChild(x); log.appendChild(box); scroll();
      };
      const thr = throttle(L);
      if (thr === 'dup') { await bot(D.ui.dup, { wait: false }); }
      else if (!D.key) {
        trk('generate_lead', { method: 'chatbot_whatsapp', service: L.service });
        await bot(D.doneWa, { wait: false }); waBox(D.sendWa, 'chat_lead');
      } else {
        const res = await submitLead(D.key, D.lang, L, ref);
        if (res === 'ok') {
          trk('generate_lead', { method: 'chatbot', service: L.service });
          await bot(D.done.replace('{n}', L.name) + `\n${D.ui.refLabel}: ${ref}`, { act: ['wa'], wait: false });
        } else {
          await bot(D.ui.failTitle + ' ' + D.ui.failBody, { wait: false }); waBox(D.ui.waSend, 'chat_lead_fail');
        }
      }
      step = ''; busy = false; input.disabled = false; input.placeholder = D.placeholder; Object.keys(lead).forEach((k) => delete lead[k]); preset = ''; details = []; input.focus();
    };

    const ask = async (text: string) => {
      text = text.trim(); if (!text || busy) return;
      clearChips(); user(stripHtml(text)); input.value = '';
      if (step) {
        if (step === 'name') {
          if (stripHtml(text).length < 2) { await bot(D.ui.errName); return; }
          lead.name = text.slice(0, 60); step = 'contact'; input.placeholder = D.askContact; await bot(D.askContact); return;
        }
        if (step === 'contact') {
          const isMail = text.includes('@');
          if (isMail ? !validEmail(text) : !validPhone(text)) { await bot(isMail ? D.ui.errEmail : D.ui.errPhone); return; }
          lead.contact = text.slice(0, 80);
          if (preset) { lead.service = preset; step = 'msg'; input.placeholder = D.askMsg; await bot(D.askMsg); return; }
          step = 'service'; input.placeholder = D.askService; await bot(D.askService, { chips: D.services }); return;
        }
        if (step === 'service') { lead.service = text.slice(0, 80); step = 'msg'; input.placeholder = D.askMsg; await bot(D.askMsg); return; }
        if (step === 'msg') { lead.msg = (D.skip as string[]).includes(norm(text)) ? '' : text.slice(0, 600); await finishLead(); return; }
      }
      if (fl) { await flowStep(text); return; }
      trk('chat_message'); userMsgs.push(text.slice(0, 200));
      const hit = match(text);
      if (!hit) { logEv('miss', { q: redact(text) }); await bot(D.fallback.a + '\n\n' + D.kb.didYouMean, { chips: D.kb.menu, act: D.fallback.act }); return; }
      logEv('hit', { id: hit.id, q: redact(text) });
      if (hit.flow) { await flowStart(hit.flow); return; }
      if (hit.topic) topic = hit.topic;
      if (hit.go) { await bot(hit.a, { wait: true }); await startLead(); return; }
      const ans = (hit.v && topic && hit.v[topic]) || hit.a;
      await bot(ans, { chips: hit.chips, links: hit.links, act: hit.act, fb: ['greet', 'thanks', 'bye'].includes(hit.id) ? undefined : { id: hit.id, q: redact(text) } });
    };

    let started = false;
    const open = () => {
      panel.hidden = false; launcher.setAttribute('aria-expanded', 'true'); launcher.classList.add('on');
      if (!started) { started = true; bot(D.hello, { chips: D.kb.menu, wait: false }); }
      setTimeout(() => input.focus(), 50);
    };
    const close = () => { panel.hidden = true; launcher.setAttribute('aria-expanded', 'false'); launcher.classList.remove('on'); launcher.focus(); };
    launcher.addEventListener('click', () => (panel.hidden ? open() : close()));
    closeBtn.addEventListener('click', close);
    panel.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape') close(); });
    formEl.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
  })();



  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
  document.querySelectorAll('.rv').forEach((el) => io.observe(el));

  const form = document.getElementById('lead') as HTMLFormElement;
  const status = form.querySelector('.status') as HTMLElement;
  const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const UI = JSON.parse(form.dataset.ui || '{}'); const FL = (form.dataset.lang || 'ar') as 'ar' | 'en';
  const openedAt = Date.now();
  const SFD = JSON.parse(form.dataset.sf || '[]') as { hint: string; msgLabel: string; msgPh: string; fields: { name: string; label: string; o: string[] }[] }[];
  const svcSel = form.elements.namedItem('service') as HTMLSelectElement;
  const fieldsBox = document.getElementById('svc-fields') as HTMLElement; const hintEl = document.getElementById('svc-hint') as HTMLElement;
  const msgLabel = document.getElementById('msg-l') as HTMLElement; const msgTa = form.elements.namedItem('message') as HTMLTextAreaElement;
  const defLabel = msgLabel.textContent || ''; const defPh = msgTa.placeholder;
  const renderSvc = () => {
    const c = SFD[svcSel.selectedIndex]; fieldsBox.textContent = '';
    if (!c) { hintEl.textContent = ''; msgLabel.textContent = defLabel; msgTa.placeholder = defPh; return; }
    hintEl.textContent = c.hint; msgLabel.textContent = c.msgLabel; msgTa.placeholder = c.msgPh;
    c.fields.forEach((f) => {
      const lab = document.createElement('label'); lab.append(f.label);
      const sel = document.createElement('select'); sel.dataset.sf = f.label; sel.name = 'sf_' + f.name;
      const o0 = document.createElement('option'); o0.value = ''; o0.textContent = form.dataset.opt || ''; sel.appendChild(o0);
      f.o.forEach((x) => { const o = document.createElement('option'); o.textContent = x; sel.appendChild(o); });
      lab.appendChild(sel); fieldsBox.appendChild(lab);
    });
  };
  const fhDyn = document.getElementById('fh-dyn') as HTMLElement; const fh = document.getElementById('fhelp') as HTMLElement;
  const renderHelp = () => {
    const c = (SFD as any)[svcSel.selectedIndex]; fhDyn.textContent = ''; if (!c) return;
    const mk = (title: string, items: string[], cls: string) => {
      const b = document.createElement('div'); b.className = 'fh-box ' + cls;
      const h = document.createElement('h3'); h.textContent = title; const ul = document.createElement('ul');
      items.forEach((x) => { const li = document.createElement('li'); li.textContent = x; ul.appendChild(li); });
      b.append(h, ul); fhDyn.appendChild(b);
    };
    mk(fh.dataset.prep || '', c.prep, 'prep'); mk(fh.dataset.get || '', c.get, 'get');
  };
  svcSel.addEventListener('change', () => { renderSvc(); renderHelp(); });
  try { const q = Number(new URLSearchParams(location.search).get('service')); if (Number.isInteger(q) && q >= 0 && q < svcSel.options.length && new URLSearchParams(location.search).has('service')) svcSel.selectedIndex = q; } catch {}
  renderSvc(); renderHelp();
  const setErr = (name: string, msg: string) => {
    const f = form.elements.namedItem(name) as HTMLInputElement | null; if (!f) return;
    const lab = f.closest('label') as HTMLElement; lab.querySelector('.ferr')?.remove();
    f.removeAttribute('aria-invalid');
    if (msg) { const m = document.createElement('em'); m.className = 'ferr'; m.textContent = msg; lab.appendChild(m); f.setAttribute('aria-invalid', 'true'); }
  };
  const clearErrs = () => ['name', 'phone', 'email', 'message'].forEach((n) => setErr(n, ''));
  form.addEventListener('input', (e) => { const n = (e.target as HTMLInputElement).name; if (n) setErr(n, ''); });

  const showSuccess = (L: Lead, ref: string, viaWa: boolean) => {
    const box = document.createElement('div'); box.className = 'form-done'; box.setAttribute('role', 'status');
    const h = document.createElement('h3'); h.textContent = UI.okTitle;
    const p = document.createElement('p'); p.textContent = viaWa ? UI.waOpened : UI.okBody;
    const r = document.createElement('p'); r.className = 'ref'; r.textContent = `${UI.refLabel}: ${ref}`;
    const a = document.createElement('a'); a.className = 'btn btn-wa'; a.target = '_blank'; a.rel = 'noopener'; a.textContent = UI.waContinue;
    a.href = waLink(form.dataset.wa!, waText(FL, L, ref)); a.dataset.evt = 'whatsapp_click'; a.dataset.loc = 'form_done';
    const again = document.createElement('button'); again.type = 'button'; again.className = 'btn btn-ghost btn-sm'; again.textContent = UI.newReq;
    again.addEventListener('click', () => { box.remove(); form.hidden = false; form.reset(); renderSvc(); });
    box.append(h, p, r, a, again); form.after(box); form.hidden = true; box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };
  const showFail = (L: Lead, ref: string) => {
    status.className = 'status err'; status.textContent = '';
    const t = document.createElement('span'); t.textContent = UI.failTitle + ' ' + UI.failBody + ' ';
    const a = document.createElement('a'); a.href = waLink(form.dataset.wa!, waText(FL, L, ref)); a.target = '_blank'; a.rel = 'noopener'; a.className = 'status-link'; a.textContent = UI.waSend;
    a.addEventListener('click', () => noteSentViaWa(L));
    status.append(t, a);
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const L: Lead = {
      name: stripHtml(String(d.get('name') || '')), phone: cleanPhone(String(d.get('phone') || '')), email: String(d.get('email') || '').trim(),
      service: String(d.get('service') || ''), budget: String(d.get('budget') || ''), message: String(d.get('message') || '').trim().slice(0, 2000), source: 'form',
      details: Array.from(fieldsBox.querySelectorAll<HTMLSelectElement>('select')).filter((x) => x.value).map((x) => [x.dataset.sf || '', x.value] as [string, string]),
    };
    status.className = 'status'; status.textContent = ''; clearErrs();
    if (d.get('botcheck') || Date.now() - openedAt < 2500) return; // سبام/بوت: تجاهل بصمت
    const errs = validate(L);
    if (errs.name) setErr('name', UI.errName);
    if (errs.contact) { setErr('phone', UI.errContact); }
    if (errs.phone) setErr('phone', UI.errPhone);
    if (errs.email) setErr('email', UI.errEmail);
    if (errs.message) setErr('message', UI.errMsg);
    if (Object.keys(errs).length) { (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus(); return; }
    const thr = throttle(L);
    if (thr !== 'ok') { status.textContent = thr === 'dup' ? UI.dup : UI.cooldown; status.classList.add(thr === 'dup' ? 'ok' : 'err'); return; }
    const ref = makeRef();
    const key = form.dataset.key;
    // لو مفتاح Web3Forms لسه متضافش: نفتح واتساب بالرسالة جاهزة
    if (!key) {
      trk('generate_lead', { method: 'whatsapp_prefill', service: L.service });
      noteSentViaWa(L);
      window.open(waLink(form.dataset.wa!, waText(FL, L, ref)), '_blank');
      showSuccess(L, ref, true); return;
    }
    btn.disabled = true; const label = btn.textContent; btn.textContent = form.dataset.sending!;
    const res = await submitLead(key, FL, L, ref);
    btn.disabled = false; btn.textContent = label;
    if (res === 'ok') { trk('generate_lead', { method: 'form', service: L.service, budget: L.budget }); showSuccess(L, ref, false); }
    else { trk('lead_send_failed', { method: 'form' }); showFail(L, ref); }
  });

  // أي لينك واتساب عام: نضيف سياق (المصدر + الخدمة المختارة + مرجع) وقت الضغط
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="wa.me/"]'); if (!a) return;
    const sel = document.querySelector<HTMLSelectElement>('#lead select[name="service"]');
    enrichWaClick(a, FL, a.dataset.loc || 'site', sel && sel.selectedIndex > 0 ? sel.value : undefined);
  }, true);
</script>
