---
import { T, type Lang } from '../i18n';
import { chatKB } from '../chatKB';
import { CONFIG, hasKey, hasBooking } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const wa = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(t.contact.waMsg)}`;
const chatData = {
  ...t.chat,
  kb: chatKB[lang],
  wa: CONFIG.whatsapp,
  waMsg: t.contact.waMsg,
  key: hasKey() ? CONFIG.web3formsKey : '',
  booking: hasBooking() ? CONFIG.bookingUrl : '',
  services: t.contact.serviceOpts,
  budgetDefault: t.contact.budgetOpts[t.contact.budgetOpts.length - 1],
  lang,
  ui: t.contact.ui,
};

const icons: Record<string, string> = {
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2" stroke-width="2" stroke-linecap="round"/>',
  target: '<circle cx="12" cy="12" r="9" stroke-width="2"/><circle cx="12" cy="12" r="4.5" stroke-width="2"/><circle cx="12" cy="12" r="1" fill="currentColor"/>',
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" stroke-width="2" stroke-linejoin="round"/>',
  users: '<circle cx="9" cy="8" r="3.5" stroke-width="2"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M16 4.8a3.5 3.5 0 0 1 0 6.4M21.5 20c0-2.8-1.6-4.7-4-5.5" stroke-width="2" stroke-linecap="round"/>',
  kanban: '<rect x="3" y="4" width="18" height="16" rx="2" stroke-width="2"/><path d="M9 8v8M15 8v5" stroke-width="2" stroke-linecap="round"/>',
  brain: '<path d="M9 4a3 3 0 0 0-3 3v1a3 3 0 0 0-2 5 3 3 0 0 0 2 5 3 3 0 0 0 6 0V4a3 3 0 0 0-3 0Zm6 0a3 3 0 0 1 3 3v1a3 3 0 0 1 2 5 3 3 0 0 1-2 5 3 3 0 0 1-6 0" stroke-width="2" stroke-linecap="round"/>',
};
const ic = (d: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const socialDefs: Record<string, { label: string; svg: string }> = {
  linkedin: { label: 'LinkedIn', svg: ic('<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 11v6M8 7.5v.01M12 17v-6M12 13.5c0-1.4 1-2.5 2.5-2.5S17 12 17 13.5V17"/>') },
  instagram: { label: 'Instagram', svg: ic('<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5v.01"/>') },
  facebook: { label: 'Facebook', svg: ic('<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5c0-.3.2-.5.5-.5Z"/>') },
  tiktok: { label: 'TikTok', svg: ic('<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.2 5 4.4"/>') },
  youtube: { label: 'YouTube', svg: ic('<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10 9.5 5 2.5-5 2.5Z"/>') },
  x: { label: 'X', svg: ic('<path d="M4 4l16 16M20 4 4 20"/>') },
  threads: { label: 'Threads', svg: ic('<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>') },
  whatsapp: { label: 'WhatsApp', svg: ic('<path d="M3 21l1.7-5A9 9 0 1 1 8 19.3L3 21Z"/><path d="M9 9c.4 2.8 2.700 5.100 6 6l1.500-1.500-2-1-1 .8c-1-.5-1.800-1.300-2.300-2.300l.8-1-1-2L9 9Z"/>') },
  github: { label: 'GitHub', svg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49v-1.71c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.4 9.4 0 0 1 12 6.84c.85 0 1.7.12 2.5.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.59.69.49A10.2 10.2 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>' },
  mostaql: { label: 'مستقل', svg: '<span class="soc-txt" aria-hidden="true">م</span>' },
};
const w = CONFIG.whatsapp;
const phoneFmt = `+${w.slice(0, 2)} ${w.slice(2, 5)} ${w.slice(5, 8)} ${w.slice(8)}`;
const socials = Object.entries(CONFIG.links as Record<string, string>)
  .filter(([k, url]) => url && socialDefs[k])
  .map(([k, url]) => ({ ...socialDefs[k], url }));
---
<a class="skip" href="#main">{t.skip}</a>

<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a href="#top" class="logo">{CONFIG.brand}<b> |</b><small>{CONFIG.tagline.toUpperCase()}</small></a>
    <nav class="links" id="nav-links" aria-label="main">
      <a href="#services">{t.nav.services}</a>
      <a href="#work">{t.nav.work}</a>
      <a href="#process">{t.nav.process}</a>
      <a href="#faq">{t.nav.faq}</a>
      <a href="#contact">{t.nav.contact}</a>
      <a class="btn btn-primary btn-sm menu-cta" href="#contact" data-evt="cta_click" data-loc="menu">{t.nav.cta}</a>
    </nav>
    <div class="nav-actions">
      <a class="lang" href={t.switchHref} hreflang={lang === 'ar' ? 'en' : 'ar'}>{t.switchLabel}</a>
      <a class="btn btn-primary btn-sm nav-cta" href="#contact" data-evt="cta_click" data-loc="nav">{t.nav.cta}</a>
      <button type="button" class="burger" id="burger" aria-expanded="false" aria-controls="nav-links" aria-label={t.nav.menu}><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<main id="main">
  <div class="hero" id="top">
    <div class="wrap hero-grid">
      <div>
        <span class="kicker">{t.hero.kicker}</span>
        <h1>{t.hero.h1a}<span class="grad">{t.hero.h1b}</span></h1>
        <p class="sub">{t.hero.sub}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#contact" data-evt="cta_click" data-loc="hero">{t.hero.primary}</a>
          <a class="btn btn-ghost" href="#services">{t.hero.secondary}</a>
        </div>
        <ul class="trust">{t.hero.trust.map((x) => <li>{x}</li>)}</ul>
        <div class="chips">{t.hero.chips.map((c) => <span class="chip">{c}</span>)}</div>
      </div>

      <div>
        <div class="mock" role="img" aria-label={t.hero.mockTitle}>
          <div class="mock-top"><div class="dots"><i></i><i></i><i></i></div><span>dashboard.live</span></div>
          <div class="kpis">
            <div class="kpi"><span>ROAS</span><b>4.2x</b> <em class="up">▲ 12%</em></div>
            <div class="kpi"><span>CPA</span><b>$8.4</b> <em class="up">▼ 9%</em></div>
            <div class="kpi"><span>RETURNS</span><b>6.1%</b> <em class="down">▲ 1.3%</em></div>
          </div>
          <div class="chart">
            <svg viewBox="0 0 320 150" width="100%" aria-hidden="true">
              <g fill="rgba(0,229,255,.55)">
                {[40, 62, 50, 78, 66, 92, 84, 110].map((h, i) => (
                  <rect class="bar" style={`animation-delay:${0.1 * i}s`} x={14 + i * 38} y={140 - h} width="22" height={h} rx="4" />
                ))}
              </g>
              <path class="draw" d="M14 110 L52 96 L90 104 L128 76 L166 84 L204 52 L242 60 L280 28" fill="none" stroke="#00ff9d" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="280" cy="28" r="4.5" fill="#00ff9d" />
            </svg>
          </div>
          <p class="mock-note">{t.hero.mockNote}</p>
        </div>
      </div>
    </div>
    <div class="wrap">
      <div class="stats rv">{t.stats.map((s) => <div class="stat"><b>{s.v}</b><span>{s.l}</span></div>)}</div>
    </div>
  </div>

  <section id="services">
    <div class="wrap">
      <div class="sec-head rv"><h2>{t.servicesTitle}</h2><p>{t.servicesSub}</p></div>
      <div class="carousel rv" data-carousel>
        <div class="track" tabindex="0" role="region" aria-roledescription="carousel" aria-label={t.servicesTitle}>
        {t.services.map((s, i) => (
          <article class="card">
            <div class="ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" set:html={icons[s.icon]} /></div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <ul>{s.pts.map((p) => <li>{p}</li>)}</ul>
            <a class="card-cta" href="#contact" data-service={i} data-service-label={s.t} data-evt="service_click" data-loc="services">{t.serviceCta}<span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span></a>
          </article>
        ))}
        </div>
        <div class="car-ctrl">
          <button type="button" class="car-btn" data-dir="prev" aria-label={lang === 'ar' ? 'السابق' : 'Previous'}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
          </button>
          <div class="car-dots"></div>
          <button type="button" class="car-btn" data-dir="next" aria-label={lang === 'ar' ? 'التالي' : 'Next'}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section id="fit">
    <div class="wrap">
      <div class="sec-head rv"><h2>{t.fitTitle}</h2><p>{t.fitSub}</p></div>
      <div class="fit">
        {t.fit.map((f) => (
          <article class="fit-card rv">
            <h3>{f.t}</h3>
            <p class="fit-row"><b class="fit-l bad">{t.fitPain}</b>{f.pain}</p>
            <p class="fit-row"><b class="fit-l good">{t.fitFix}</b>{f.fix}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="sec-head rv"><h2>{t.workTitle}</h2><p>{t.workSub}</p></div>
      <div class="work">
        {t.work.map((w, i) => (
          <article class="work-card rv">
            <span class={`tag ${i < 2 ? 'live' : ''}`}>{w.tag}</span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
            <ul class="stack">{w.stack.map((x) => <li>{x}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="work-more rv">
        <a class="btn btn-ghost" href={CONFIG.links.github} target="_blank" rel="noopener noreferrer me" data-evt="github_click" data-loc="work">{t.workCta}</a>
        <a class="btn btn-ghost" href={CONFIG.links.portfolio} target="_blank" rel="noopener noreferrer me" data-evt="portfolio_click" data-loc="work">{t.portfolioCta}</a>
      </p>
    </div>
  </section>

  <section id="process">
    <div class="wrap">
      <div class="sec-head rv"><h2>{t.processTitle}</h2><p>{t.processSub}</p></div>
      <div class="steps">
        {t.process.map((p) => <div class="step rv"><span class="n">{p.n}</span><h3>{p.t}</h3><p>{p.d}</p></div>)}
      </div>
    </div>
  </section>

  <section id="why">
    <div class="wrap">
      <div class="about rv">
        <figure class="about-photo">
          <img src="/albaraa.jpg" srcset="/albaraa-320.jpg 320w, /albaraa.jpg 640w" sizes="(max-width: 640px) 160px, 220px" width="640" height="640" alt={t.photoAlt} loading="lazy" decoding="async" />
        </figure>
        <div class="sec-head"><h2>{t.whyTitle}</h2><p>{t.whySub}</p></div>
      </div>
      <div class="why">{t.why.map((w) => <div class="rv"><h3>{w.t}</h3><p>{w.d}</p></div>)}</div>
    </div>
  </section>

  <section id="faq">
    <div class="wrap" style="max-width: 820px">
      <div class="sec-head rv"><h2>{t.faqTitle}</h2></div>
      {t.faq.map((f) => <details class="rv"><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <section id="contact">
    <div class="wrap contact-grid">
      <div class="rv">
        <div class="sec-head"><h2>{t.contact.title}</h2><p>{t.contact.sub}</p></div>
        <div class="contact-side">
          <a class="btn btn-wa" href={wa} target="_blank" rel="noopener" data-evt="whatsapp_click" data-loc="contact">{t.contact.wa}</a>
          {hasBooking() && <a class="btn btn-ghost" href={CONFIG.bookingUrl} target="_blank" rel="noopener" data-evt="booking_click" data-loc="contact">{t.contact.book}</a>}
          <a class="btn btn-ghost" href={`mailto:${CONFIG.email}`} style="direction:ltr" data-evt="email_click" data-loc="contact">{CONFIG.email}</a>
          <p class="assure">{t.contact.assure}</p>
        </div>
      </div>

      <p class="form-hint">{t.contact.formHint}</p>
      <form id="lead" class="form rv" novalidate
        data-key={hasKey() ? CONFIG.web3formsKey : ''}
        data-wa={CONFIG.whatsapp}
        data-lang={lang} data-ui={JSON.stringify(t.contact.ui)}
        data-ok={t.contact.ok} data-err={t.contact.err} data-req={t.contact.required} data-sending={t.contact.sending}>
        <input type="text" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="row2">
          <label>{t.contact.name}<input name="name" required aria-required="true" autocomplete="name" /></label>
          <label>{t.contact.phone}<input name="phone" inputmode="tel" autocomplete="tel" dir="ltr" /></label>
        </div>
        <label>{t.contact.email}<input name="email" type="email" autocomplete="email" dir="ltr" /></label>
        <div class="row2">
          <label>{t.contact.service}
            <select name="service">{t.contact.serviceOpts.map((o) => <option>{o}</option>)}</select>
          </label>
          <label>{t.contact.budget}
            <select name="budget">{t.contact.budgetOpts.map((o) => <option>{o}</option>)}</select>
          </label>
        </div>
        <label>{t.contact.msg}<textarea name="message" placeholder={t.contact.msgPh} required aria-required="true"></textarea></label>
        <button class="btn btn-primary" type="submit">{t.contact.send}</button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="#top" class="logo">{CONFIG.brand}<b> |</b><small>{CONFIG.tagline.toUpperCase()}</small></a>
        <p>{t.footer.about}</p>
        <a class="btn btn-primary btn-sm" href="#contact" data-evt="cta_click" data-loc="footer">{t.footer.cta}</a>
        {socials.length > 0 && (
          <ul class="socials" aria-label="social">
            {socials.map((s) => (
              <li><a class="soc" href={s.url} target="_blank" rel="noopener noreferrer me" aria-label={s.label} title={s.label} set:html={s.svg} /></li>
            ))}
          </ul>
        )}
      </div>

      <nav class="foot-col" aria-label={t.footer.colLinks}>
        <p class="foot-h">{t.footer.colLinks}</p>
        <ul>
          <li><a href="#services">{t.nav.services}</a></li>
          <li><a href="#work">{t.nav.work}</a></li>
          <li><a href="#process">{t.nav.process}</a></li>
          <li><a href="#faq">{t.nav.faq}</a></li>
          <li><a href="#contact">{t.nav.contact}</a></li>
          <li><a href={t.switchHref} hreflang={lang === 'ar' ? 'en' : 'ar'}>{t.switchLabel}</a></li>
        </ul>
      </nav>

      <div class="foot-col">
        <p class="foot-h">{t.footer.colServices}</p>
        <ul>{t.footer.svc.map((x) => <li><a href="#services">{x}</a></li>)}</ul>
      </div>

      <div class="foot-col">
        <p class="foot-h">{t.footer.colContact}</p>
        <ul>
          <li><a href={wa} target="_blank" rel="noopener" dir="ltr" data-evt="whatsapp_click" data-loc="footer">{phoneFmt}</a></li>
          <li><a href={`mailto:${CONFIG.email}`} dir="ltr" data-evt="email_click" data-loc="footer">{CONFIG.email}</a></li>
          <li><span>{t.footer.area}</span></li>
          <li><span class="reply">{t.footer.reply}</span></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {new Date().getFullYear()} {CONFIG.brand} | {CONFIG.tagline}. {t.footer.rights}.</span>
      <span class="built">{t.footer.built}</span>
      <a class="to-top" href="#top">{t.footer.top} <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<a class="wa-float" href={wa} target="_blank" rel="noopener" aria-label={t.contact.wa} data-evt="whatsapp_click" data-loc="float">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.2c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.4-3.9-4.5-4.1-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9.9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.300 1.700 2.100 1.200 1 2.200 1.400 2.500 1.500.3.1.5.1.7-.1.200-.200.800-.900 1-1.200.2-.3.400-.3.700-.2l1.900.9c.3.100.5.200.6.300.1.200.1.800-.1 1.400Z"/></svg>
</a>

<button type="button" class="chat-launcher" id="chat-open" aria-expanded="false" aria-controls="chat-panel" aria-label={t.chat.open} data-evt="chat_open" data-loc="launcher">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.5-4.6A8 8 0 1 1 21 12Z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01" stroke-width="2.6"/></svg>
</button>

<section class="chat" id="chat-panel" role="dialog" aria-label={t.chat.title} hidden>
  <header class="chat-head">
    <img src="/albaraa-320.jpg" width="40" height="40" alt="" />
    <div><b>{t.chat.title}</b><small>{t.chat.status}</small></div>
    <button type="button" class="chat-x" id="chat-close" aria-label={t.chat.close}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </header>
  <div class="chat-log" id="chat-log" role="log" aria-live="polite"></div>
  <form class="chat-form" id="chat-form" autocomplete="off">
    <input id="chat-input" type="text" maxlength="400" placeholder={t.chat.placeholder} aria-label={t.chat.placeholder} />
    <button type="submit" class="chat-send" aria-label={t.chat.send}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z"/></svg>
    </button>
  </form>
  <p class="chat-note">{t.chat.note}</p>
</section>
<script type="application/json" id="chat-data" is:inline set:html={JSON.stringify(chatData)} />

<script>
  import { getCtx, makeRef, cleanPhone, validPhone, validEmail, stripHtml, validate, waText, waLink, enrichWaClick, throttle, submitLead, trackConversionEvent, type Lead } from '../lib/lead';
  getCtx();
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector('.track') as HTMLElement;
    const cards = Array.from(track.children) as HTMLElement[];
    const prev = root.querySelector('[data-dir="prev"]') as HTMLButtonElement;
    const next = root.querySelector('[data-dir="next"]') as HTMLButtonElement;
    const dotsBox = root.querySelector('.car-dots') as HTMLElement;
    const sign = () => (getComputedStyle(track).direction === 'rtl' ? -1 : 1);
    const step = () => (cards.length > 1 ? Math.abs(cards[1].offsetLeft - cards[0].offsetLeft) : track.clientWidth);
    const maxScroll = () => track.scrollWidth - track.clientWidth;
    const pos = () => Math.abs(track.scrollLeft);
    const goTo = (i: number) => track.scrollTo({ left: sign() * Math.min(i * step(), maxScroll()), behavior: 'smooth' });
    // dots: one per scroll position
    const pages = () => Math.max(1, Math.round(maxScroll() / step()) + 1);
    let dots: HTMLButtonElement[] = [];
    const buildDots = () => {
      dotsBox.innerHTML = '';
      dots = Array.from({ length: pages() }, (_, i) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'car-dot'; b.setAttribute('aria-label', String(i + 1));
        b.addEventListener('click', () => goTo(i));
        dotsBox.appendChild(b); return b;
      });
    };
    const update = () => {
      const p = pos(), m = maxScroll();
      prev.disabled = p < 4;
      next.disabled = p > m - 4;
      const idx = p > m - 4 ? dots.length - 1 : Math.round(p / step());
      dots.forEach((d, i) => d.classList.toggle('on', i === idx));
    };
    prev.addEventListener('click', () => goTo(Math.round(pos() / step()) - 1));
    next.addEventListener('click', () => goTo(Math.round(pos() / step()) + 1));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', () => { buildDots(); update(); });
    buildDots(); update();
  });

  // Local-only event dispatch; no gtag call and no external transmission.
  const trk = trackConversionEvent;
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    const el = target.closest<HTMLElement>('[data-evt]');
    if (el) {
      const eventParams: Record<string, unknown> = { location: el.dataset.loc };
      if (el.dataset.evt === 'service_click') eventParams.service = el.dataset.serviceLabel;
      trk(el.dataset.evt!, eventParams);
      if (el.dataset.evt === 'whatsapp_click' && ['form_done', 'form_fail', 'chat_lead', 'chat_lead_fail'].includes(el.dataset.loc || '')) {
        const serviceSelect = document.querySelector<HTMLSelectElement>('#lead select[name="service"]');
        trk('lead_whatsapp_handoff', { location: el.dataset.loc, service: el.dataset.leadService || serviceSelect?.value });
      }
    }
    const sv = target.closest<HTMLElement>('[data-service]');
    if (sv) {
      const sel = document.querySelector<HTMLSelectElement>('#lead select[name="service"]');
      const index = Number(sv.dataset.service);
      if (sel && Number.isInteger(index) && index >= 0 && index < sel.options.length) {
        sel.selectedIndex = index;
        sel.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }
  });


  // ===== المساعد الآلي (rule-based، من غير سيرفر) =====
  (() => {
    const raw = document.getElementById('chat-data');
    const panel = document.getElementById('chat-panel') as HTMLElement | null;
    const launcher = document.getElementById('chat-open') as HTMLButtonElement | null;
    if (!raw || !panel || !launcher) return;
    const D = JSON.parse(raw.textContent || '{}');
    const log = document.getElementById('chat-log') as HTMLElement;
    const formEl = document.getElementById('chat-form') as HTMLFormElement;
    const input = document.getElementById('chat-input') as HTMLInputElement;
    const closeBtn = document.getElementById('chat-close') as HTMLButtonElement;

    const norm = (s: string) => s.toLowerCase()
      .replace(/[ً-ٰٟـ]/g, '').replace(/[إأآٱ]/g, 'ا').replace(/ى/g, 'ي').replace(/ة/g, 'ه')
      .replace(/[ؤئ]/g, 'ء').replace(/[٠-٩]/g, (d) => String('٠١٢٣٤٥٦٧٨٩'.indexOf(d)))
      .replace(/[^\p{L}\p{N}\s]/gu, ' ').replace(/\s+/g, ' ').trim();
    const prep = (s: string) => norm(s).split(' ').filter(Boolean)
      .map((w) => (w.startsWith('ال') && w.length > 4 ? w.slice(2) : w));
    const kn: Record<string, { w: string; short: boolean; words: string[] }[]> = {};
    D.kb.entries.forEach((e: any) => {
      kn[e.id] = (e.k as string[]).map((k) => {
        const words = prep(k);
        const w = words.join(' ');
        return { w, words, short: w.length <= 3 && !w.includes(' ') };
      });
    });

    // Expand common Egyptian Arabic / English phrasing into existing intents.
    // This stays fully client-side and does not send messages to an external service.
    const aliases: { re: RegExp; add: string }[] = [
      { re: /\b(بكام|بكم|كام السعر|السعر كام|عايز اعرف السعر|عاوز اعرف السعر|الاسعار|تكلفتها|التكلفه كام|budget|how much does it cost|what does it cost|pricing details)\b/i, add: 'تكلفة price pricing cost how much' },
      { re: /\b(قد ايه|هياخد وقت قد ايه|ياخد وقت|محتاج وقت|وقت قد ايه|المدة كام|امتى يخلص|timeline|delivery time|turnaround time)\b/i, add: 'مدة duration timeline how long' },
      { re: /\b(عايز ابدا|عاوز ابدا|ابدأ ازاي|نبدأ ازاي|احجز استشارة|عايز استشارة|عاوز استشارة|محتاج استشارة|ساعدني اختار|recommend a service|where should i start)\b/i, add: 'استشارة مجانية consultation not sure where to start' },
      { re: /\b(وريني شغلك|ممكن اشوف شغلك|عندك نماذج|نماذج شغل|شغل عملته|سابقة اعمال|سابقة أعمال|case studies|show me your work|show examples)\b/i, add: 'اعمال سابقة portfolio previous work examples' },
      { re: /\b(اكلمك|اكلم البراء|عايز اتواصل|عاوز اتواصل|رقمك|رقم الواتس|واتساب|تواصل معاك|contact details|talk to albaraa|speak to someone)\b/i, add: 'اتواصل اكلم البراء واتساب contact human' },
      { re: /\b(بتقدم ايه|بتعمل ايه|ايه اللي بتعمله|الخدمات المتاحة|تقدر تعمل ايه|what can you do|what services|services offered)\b/i, add: 'خدمات services what do you offer' },
      { re: /\b(شيتات|جوجل شيت|جوجل شيتس|ملفات اكسل|ملف اكسيل|spreadsheet|google sheets|excel files)\b/i, add: 'اكسيل excel google sheets automation تقارير' },
      { re: /\b(مبيعاتي واقعه|المبيعات قلت|الاعلانات مش جايبه|الحملات خسرانه|بحرق فلوس في الاعلانات|ads are not working|sales are down|campaigns losing money)\b/i, add: 'تحليلات تسويق تحليل حملات marketing analytics campaign performance' },
      { re: /\b(الداتا ملخبطه|البيانات ملخبطه|بياناتي مش منظمه|الداتا مش نضيفه|تنضيف الداتا|clean my data|messy data|dirty data)\b/i, add: 'تنظيف بيانات automation no data' },
      { re: /\b(داشبورد|لوحه بيانات|لوحة بيانات|متابعه الارقام|متابعة الارقام|dashboard report|track kpis)\b/i, add: 'لوحات تحكم dashboard bi kpi' },
    ];
    const expand = (text: string) => {
      const base = norm(text);
      const extra = aliases.filter((a) => new RegExp(a.re.source.replace(/\\b/g, ''), a.re.flags).test(base)).map((a) => a.add).join(' ');
      return prep(base + ' ' + extra);
    };
    const match = (text: string) => {
      const toks = expand(text);
      const joined = ' ' + toks.join(' ') + ' ';
      const original = prep(text);
      const originalJoined = ' ' + original.join(' ') + ' ';
      let best: any = null, bs = 0;
      for (const e of D.kb.entries) {
        let sc = 0;
        for (const k of kn[e.id] || []) {
          if (k.short ? original.includes(k.w) : originalJoined.includes(k.w)) {
            // Prefer meaningful multi-word matches from the user's actual message.
            sc += k.w.length + (k.words.length > 1 ? 5 : 0);
          } else if (k.short ? toks.includes(k.w) : joined.includes(k.w)) {
            // Expanded synonyms help recall, but carry less weight to avoid false matches.
            sc += Math.max(1, Math.floor(k.w.length * 0.55));
          } else {
            // Partial word overlap catches natural phrasing without accepting a single generic word.
            const overlap = k.words.filter((w) => w.length >= 4 && toks.some((t) => t === w || (t.length >= 5 && w.length >= 5 && (t.startsWith(w.slice(0, 5)) || w.startsWith(t.slice(0, 5))))).length;
            if (overlap >= 2) sc += overlap * 2;
          }
        }
        if (sc > bs) { bs = sc; best = e; }
      }
      // Don't force a confident-sounding answer when the message is unrelated.
      const shortIntents = new Set(['hi', 'hey', 'bye', 'ai', 'bi', 'ml', 'roas', 'cpa', 'cac', 'rfm', 'cod', 'kpi', 'seo', 'sql', 'crm', 'api', 'ga4', 'pm']);
      if (best && bs < 3 && !['greet', 'thanks', 'bye', 'bot', 'human'].includes(best.id) && !original.some((w: string) => shortIntents.has(w))) return null;
      return best;
    };

    const scroll = () => { log.scrollTop = log.scrollHeight; };
    const el = (tag: string, cls?: string, text?: string) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text) n.textContent = text; return n; };

    let step: '' | 'name' | 'contact' | 'service' | 'msg' = '';
    const lead: Record<string, string> = {};
    let busy = false;

    const clearChips = () => log.querySelectorAll('.chat-opts').forEach((n) => n.remove());
    const user = (text: string) => { const m = el('div', 'msg me', text); log.appendChild(m); scroll(); };
    const typing = () => { const t = el('div', 'msg bot typing'); t.innerHTML = '<i></i><i></i><i></i>'; t.setAttribute('aria-hidden', 'true'); log.appendChild(t); scroll(); return t; };

    const bot = (text: string, opts: { chips?: string[]; act?: string[]; wait?: boolean } = {}) => {
      const t = typing();
      const delay = opts.wait === false ? 0 : Math.min(900, 280 + text.length * 6);
      return new Promise<void>((res) => setTimeout(() => {
        t.remove();
        log.appendChild(el('div', 'msg bot', text));
        const box = el('div', 'chat-opts');
        (opts.chips || []).forEach((c) => {
          const b = el('button', 'chip-btn', c); b.type = 'button';
          b.addEventListener('click', () => ask(c)); box.appendChild(b);
        });
        (opts.act || []).forEach((a) => {
          if (a === 'lead') { const b = el('button', 'act-btn', D.actLead); b.type = 'button'; b.addEventListener('click', startLead); box.appendChild(b); }
          if (a === 'wa') { const x = el('a', 'act-btn wa', D.actWa) as HTMLAnchorElement; x.href = `https://wa.me/${D.wa}?text=${encodeURIComponent(D.waMsg)}`; x.target = '_blank'; x.rel = 'noopener'; x.dataset.evt = 'whatsapp_click'; x.dataset.loc = 'chat'; box.appendChild(x); }
          if (a === 'book' && D.booking) { const x = el('a', 'act-btn', D.actBook) as HTMLAnchorElement; x.href = D.booking; x.target = '_blank'; x.rel = 'noopener'; x.dataset.evt = 'booking_click'; x.dataset.loc = 'chat'; box.appendChild(x); }
        });
        if (box.childElementCount) log.appendChild(box);
        scroll(); res();
      }, delay));
    };

    const startLead = async () => {
      clearChips(); step = 'name'; trk('chat_lead_start');
      input.placeholder = D.askName;
      await bot(D.askName, { act: [] });
      input.focus();
    };

    // ---------- جلسات الاستشارة الموجّهة (ستاتيك) ----------
    let topic = '';
    const userMsgs: string[] = [];
    let preset = ''; let summary = '';
    type Fl = { f: any; i: number; picks: { q: string; l: string; t: string }[] };
    let fl: Fl | null = null;
    const flowChips = (f: any, i: number) => {
      const c = f.steps[i].o.map((o: any) => o.l);
      if (i > 0) c.push(D.kb.flowBack);
      c.push(D.kb.flowCancel); return c;
    };
    const flowAsk = async () => { if (fl) await bot(fl.f.steps[fl.i].q, { chips: flowChips(fl.f, fl.i) }); };
    const flowStart = async (id: string) => {
      const f = D.kb.flows.find((x: any) => x.id === id); if (!f) return;
      fl = { f, i: 0, picks: [] }; topic = id === 'any' ? '' : id; trk('chat_flow_start', { flow: id });
      await bot(f.intro, { wait: true }); await flowAsk();
    };
    const flowFinish = async () => {
      if (!fl) return; const f = fl.f; const picks = fl.picks; fl = null;
      preset = D.services[f.svc] || ''; summary = picks.map((p) => `- ${p.q} ${p.l}`).join('\n');
      trk('chat_flow_done', { flow: f.id });
      await bot(f.intro + '\n\n' + picks.map((p) => '• ' + p.t).join('\n') + '\n\n' + f.outro, { act: ['lead', 'wa'] });
    };
    const flowStep = async (text: string) => {
      if (!fl) return; const n = norm(text);
      if (n === norm(D.kb.flowCancel)) { fl = null; await bot(D.kb.menuIntro || D.hello, { chips: D.kb.menu }); return; }
      if (n === norm(D.kb.flowBack)) { fl.i = Math.max(0, fl.i - 1); fl.picks.length = fl.i; await flowAsk(); return; }
      const st = fl.f.steps[fl.i];
      let opt = st.o.find((o: any) => norm(o.l) === n);
      if (!opt && n.length > 2) opt = st.o.find((o: any) => norm(o.l).includes(n) || (n.includes(norm(o.l)) && norm(o.l).length > 3));
      if (!opt) { await bot(D.kb.flowPick, { chips: flowChips(fl.f, fl.i), wait: false }); return; }
      fl.picks[fl.i] = { q: st.q, l: opt.l, t: opt.t }; fl.i++;
      if (fl.i >= fl.f.steps.length) await flowFinish(); else await flowAsk();
    };

    const finishLead = async () => {
      trk('lead_submit_attempt', { method: D.key ? 'chatbot_email' : 'chatbot_whatsapp', service: lead.service || preset || '' });
      busy = true; input.disabled = true;
      const msg = (lead.msg || '') + (summary ? `\n\n[${D.lang === 'ar' ? 'ملخص الاستشارة' : 'Consultation summary'}]\n${summary}` : '') + (userMsgs.length ? `\n\n[${D.lang === 'ar' ? 'من محادثة الشات' : 'From chat'}]\n${userMsgs.slice(-4).map((m) => '- ' + m).join('\n').slice(0, 700)}` : '');
      const isMail = lead.contact.includes('@');
      const L: Lead = { name: stripHtml(lead.name), phone: isMail ? '' : cleanPhone(lead.contact), email: isMail ? lead.contact.trim() : '', service: lead.service, budget: D.budgetDefault, message: msg.trim(), source: 'chatbot' };
      const ref = makeRef();
      await bot(D.sending, { wait: false });
      const waBox = (label: string, loc: string) => {
        const box = el('div', 'chat-opts');
        const x = el('a', 'act-btn wa', label) as HTMLAnchorElement;
        x.href = waLink(D.wa, waText(D.lang, L, ref)); x.target = '_blank'; x.rel = 'noopener'; x.dataset.evt = 'whatsapp_click'; x.dataset.loc = loc; x.dataset.leadService = L.service;
        box.appendChild(x); log.appendChild(box); scroll();
      };
      const thr = throttle(L);
      if (thr === 'dup') { await bot(D.ui.dup, { wait: false }); }
      else if (!D.key) {
        trk('lead_whatsapp_handoff', { method: 'chatbot_whatsapp', location: 'chat', service: L.service });
        await bot(D.doneWa, { wait: false }); waBox(D.sendWa, 'chat_lead');
      } else {
        const res = await submitLead(D.key, D.lang, L, ref);
        if (res === 'ok') {
          trk('lead_submit_success', { method: 'chatbot_email', service: L.service });
          await bot(D.done.replace('{n}', L.name) + `\n${D.ui.refLabel}: ${ref}`, { act: ['wa'], wait: false });
        } else {
          await bot(D.ui.failTitle + ' ' + D.ui.failBody, { wait: false }); waBox(D.ui.waSend, 'chat_lead_fail');
        }
      }
      step = ''; busy = false; input.disabled = false; input.placeholder = D.placeholder; Object.keys(lead).forEach((k) => delete lead[k]); preset = ''; summary = ''; input.focus();
    };

    const ask = async (text: string) => {
      text = text.trim(); if (!text || busy) return;
      clearChips(); user(stripHtml(text)); input.value = '';
      if (step) {
        if (step === 'name') {
          if (stripHtml(text).length < 2) { await bot(D.ui.errName); return; }
          lead.name = text.slice(0, 60); step = 'contact'; input.placeholder = D.askContact; await bot(D.askContact); return;
        }
        if (step === 'contact') {
          const isMail = text.includes('@');
          if (isMail ? !validEmail(text) : !validPhone(text)) { await bot(isMail ? D.ui.errEmail : D.ui.errPhone); return; }
          lead.contact = text.slice(0, 80);
          if (preset) { lead.service = preset; step = 'msg'; input.placeholder = D.askMsg; await bot(D.askMsg); return; }
          step = 'service'; input.placeholder = D.askService; await bot(D.askService, { chips: D.services }); return;
        }
        if (step === 'service') { lead.service = text.slice(0, 80); step = 'msg'; input.placeholder = D.askMsg; await bot(D.askMsg); return; }
        if (step === 'msg') { lead.msg = (D.skip as string[]).includes(norm(text)) ? '' : text.slice(0, 600); await finishLead(); return; }
      }
      if (fl) { await flowStep(text); return; }
      trk('chat_message'); userMsgs.push(text.slice(0, 200));
      const hit = match(text);
      if (!hit) { await bot(D.fallback.a + '\n\n' + D.kb.didYouMean, { chips: D.kb.menu, act: D.fallback.act }); return; }
      if (hit.flow) { await flowStart(hit.flow); return; }
      if (hit.topic) topic = hit.topic;
      if (hit.go) { await bot(hit.a, { wait: true }); await startLead(); return; }
      const ans = (hit.v && topic && hit.v[topic]) || hit.a;
      await bot(ans, { chips: hit.chips, act: hit.act });
    };

    let started = false;
    const open = () => {
      panel.hidden = false; launcher.setAttribute('aria-expanded', 'true'); launcher.classList.add('on');
      if (!started) { started = true; bot(D.hello, { chips: D.kb.menu, wait: false }); }
      setTimeout(() => input.focus(), 50);
    };
    const close = () => { panel.hidden = true; launcher.setAttribute('aria-expanded', 'false'); launcher.classList.remove('on'); launcher.focus(); };
    launcher.addEventListener('click', () => (panel.hidden ? open() : close()));
    closeBtn.addEventListener('click', close);
    panel.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape') close(); });
    formEl.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
  })();

  // ===== الهيدر: قائمة الموبايل + السكشن النشط + ظل عند السكرول =====
  (() => {
    const nav = document.getElementById('nav'); const burger = document.getElementById('burger') as HTMLButtonElement | null;
    const links = document.getElementById('nav-links'); if (!nav || !burger || !links) return;
    const setOpen = (o: boolean) => { nav.classList.toggle('open', o); burger.setAttribute('aria-expanded', String(o)); };
    burger.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
    links.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    document.addEventListener('click', (e) => { if (!nav.contains(e.target as Node)) setOpen(false); });
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
    onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
    const map = new Map<string, HTMLElement>();
    links.querySelectorAll<HTMLAnchorElement>('a[href^="#"]:not(.btn)').forEach((a) => map.set(a.getAttribute('href')!.slice(1), a));
    const so = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { map.forEach((a) => a.classList.remove('active')); map.get(e.target.id)?.classList.add('active'); }
    }), { rootMargin: '-45% 0px -50% 0px' });
    map.forEach((_, id) => { const s = document.getElementById(id); if (s) so.observe(s); });
  })();

  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
  document.querySelectorAll('.rv').forEach((el) => io.observe(el));

  const form = document.getElementById('lead') as HTMLFormElement;
  const status = form.querySelector('.status') as HTMLElement;
  const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const UI = JSON.parse(form.dataset.ui || '{}'); const FL = (form.dataset.lang || 'ar') as 'ar' | 'en';
  const openedAt = Date.now();
  const setErr = (name: string, msg: string) => {
    const f = form.elements.namedItem(name) as HTMLInputElement | null; if (!f) return;
    const lab = f.closest('label') as HTMLElement; lab.querySelector('.ferr')?.remove();
    f.removeAttribute('aria-invalid');
    if (msg) { const m = document.createElement('em'); m.className = 'ferr'; m.textContent = msg; lab.appendChild(m); f.setAttribute('aria-invalid', 'true'); }
  };
  const clearErrs = () => ['name', 'phone', 'email', 'message'].forEach((n) => setErr(n, ''));
  form.addEventListener('input', (e) => { const n = (e.target as HTMLInputElement).name; if (n) setErr(n, ''); });
  let formStartTracked = false;
  form.addEventListener('focusin', () => {
    if (formStartTracked) return;
    formStartTracked = true;
    trk('lead_form_start', { location: 'contact' });
  });

  const showSuccess = (L: Lead, ref: string, viaWa: boolean) => {
    const box = document.createElement('div'); box.className = 'form-done'; box.setAttribute('role', 'status');
    const h = document.createElement('h3'); h.textContent = UI.okTitle;
    const p = document.createElement('p'); p.textContent = viaWa ? UI.waOpened : UI.okBody;
    const r = document.createElement('p'); r.className = 'ref'; r.textContent = `${UI.refLabel}: ${ref}`;
    const a = document.createElement('a'); a.className = 'btn btn-wa'; a.target = '_blank'; a.rel = 'noopener'; a.textContent = UI.waContinue;
    a.href = waLink(form.dataset.wa!, waText(FL, L, ref)); a.dataset.evt = 'whatsapp_click'; a.dataset.loc = 'form_done'; a.dataset.leadService = L.service;
    const again = document.createElement('button'); again.type = 'button'; again.className = 'btn btn-ghost btn-sm'; again.textContent = UI.newReq;
    again.addEventListener('click', () => { box.remove(); form.hidden = false; form.reset(); });
    box.append(h, p, r, a, again); form.after(box); form.hidden = true; box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };
  const showFail = (L: Lead, ref: string) => {
    status.className = 'status err'; status.textContent = '';
    const t = document.createElement('span'); t.textContent = UI.failTitle + ' ' + UI.failBody + ' ';
    const a = document.createElement('a'); a.href = waLink(form.dataset.wa!, waText(FL, L, ref)); a.target = '_blank'; a.rel = 'noopener'; a.className = 'status-link'; a.textContent = UI.waSend;
    a.dataset.evt = 'whatsapp_click'; a.dataset.loc = 'form_fail'; a.dataset.leadService = L.service;
    status.append(t, a);
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(form);
    trk('lead_submit_attempt', { method: form.dataset.key ? 'email_form' : 'whatsapp_prefill', service: String(d.get('service') || '') });
    const L: Lead = {
      name: stripHtml(String(d.get('name') || '')), phone: cleanPhone(String(d.get('phone') || '')), email: String(d.get('email') || '').trim(),
      service: String(d.get('service') || ''), budget: String(d.get('budget') || ''), message: String(d.get('message') || '').trim().slice(0, 2000), source: 'form',
    };
    status.className = 'status'; status.textContent = ''; clearErrs();
    if (d.get('botcheck') || Date.now() - openedAt < 2500) return; // سبام/بوت: تجاهل بصمت
    const errs = validate(L);
    if (errs.name) setErr('name', UI.errName);
    if (errs.contact) { setErr('phone', UI.errContact); }
    if (errs.phone) setErr('phone', UI.errPhone);
    if (errs.email) setErr('email', UI.errEmail);
    if (errs.message) setErr('message', UI.errMsg);
    if (Object.keys(errs).length) { (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus(); return; }
    const thr = throttle(L);
    if (thr !== 'ok') { status.textContent = thr === 'dup' ? UI.dup : UI.cooldown; status.classList.add(thr === 'dup' ? 'ok' : 'err'); return; }
    const ref = makeRef();
    const key = form.dataset.key;
    // لو مفتاح Web3Forms لسه متضافش: نفتح واتساب بالرسالة جاهزة
    if (!key) {
      trk('lead_whatsapp_handoff', { method: 'whatsapp_prefill', location: 'form', service: L.service });
      window.open(waLink(form.dataset.wa!, waText(FL, L, ref)), '_blank');
      showSuccess(L, ref, true); return;
    }
    btn.disabled = true; const label = btn.textContent; btn.textContent = form.dataset.sending!;
    const res = await submitLead(key, FL, L, ref);
    btn.disabled = false; btn.textContent = label;
    if (res === 'ok') { trk('lead_submit_success', { method: 'email_form', service: L.service, budget: L.budget }); showSuccess(L, ref, false); }
    else { trk('lead_send_failed', { method: 'form' }); showFail(L, ref); }
  });

  // أي لينك واتساب عام: نضيف سياق (المصدر + الخدمة المختارة + مرجع) وقت الضغط
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="wa.me/"]'); if (!a) return;
    const sel = document.querySelector<HTMLSelectElement>('#lead select[name="service"]');
    enrichWaClick(a, FL, a.dataset.loc || 'site', sel && sel.selectedIndex > 0 ? sel.value : undefined);
  }, true);
</script>
