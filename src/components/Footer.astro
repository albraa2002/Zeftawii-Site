---
import { T, type Lang } from '../i18n';
import { CONFIG } from '../config';
import { UI, P } from '../content/ui';
import { services } from '../content/services';
import { socialDefs } from '../lib/socials';
import { icon } from '../lib/icons';
interface Props { lang: Lang; band?: boolean }
const { lang, band = true } = Astro.props; const t = T[lang]; const u = UI[lang]; const ar = lang === 'ar';
const home = P(lang, '/');
const w = CONFIG.whatsapp; const phoneFmt = `+${w.slice(0, 2)} ${w.slice(2, 5)} ${w.slice(5, 8)} ${w.slice(8)}`;
const wa = `https://wa.me/${w}?text=${encodeURIComponent(t.contact.waMsg)}`;
const socials = Object.entries(CONFIG.links as Record<string, string>).filter(([k, url]) => url && socialDefs[k]).map(([k, url]) => ({ ...socialDefs[k], url }));
const L = ar ? { bandH: 'جاهز تحوّل أرقامك لقرارات؟', bandP: 'ابعت لي حالتك وهرد عليك خلال يوم عمل. الاستشارة الأولى مجانية وبدون التزام.', explore: 'استكشف', book: 'احجز استشارة مجانية', chat: 'واتساب' }
  : { bandH: 'Ready to turn your numbers into decisions?', bandP: 'Send me your case and I will reply within one business day. The first consultation is free and no-commitment.', explore: 'Explore', book: 'Book a free consultation', chat: 'WhatsApp' };
const explore = [['tools', u.tools, '/tools/'], ['solutions', u.solutions, '/solutions/'], ['glossary', u.glossary, '/glossary/'], ['blog', u.blog, '/blog/'], ['resources', u.resources, '/resources/'], ['work', u.work, '/work/'], ['about', u.about, '/about/']] as const;
---
{band && (
  <section class="cta-band" aria-labelledby="cb-h">
    <div class="wrap cta-band-in">
      <div><h2 id="cb-h">{L.bandH}</h2><p>{L.bandP}</p></div>
      <div class="cta-row">
        <a class="btn btn-primary" href={home + '#contact'} data-evt="cta_click" data-loc="band">{L.book}</a>
        <a class="btn btn-wa" href={wa} target="_blank" rel="noopener" data-evt="whatsapp_click" data-loc="band">{L.chat}</a>
      </div>
    </div>
  </section>
)}
<footer>
  <div class="wrap">
    <div class="foot-top foot4">
      <div class="foot-brand">
        <a href={home} class="logo">{CONFIG.brand}<b> |</b><small>{CONFIG.tagline.toUpperCase()}</small></a>
        <p>{t.footer.about}</p>
        {socials.length > 0 && (
          <ul class="socials" aria-label="social">
            {socials.map((s) => (<li><a class="soc" href={s.url} target="_blank" rel="noopener noreferrer me" aria-label={s.label} title={s.label} set:html={s.svg} /></li>))}
            <li><a class="soc" href={P(lang, '/rss.xml')} aria-label="RSS" title="RSS" set:html={icon('rss', 18)} /></li>
          </ul>
        )}
      </div>
      <div class="foot-col">
        <p class="foot-h">{t.footer.colServices}</p>
        <ul>{services.map((s) => <li><a href={P(lang, `/services/${s.slug}/`)}>{s[lang].name}</a></li>)}</ul>
      </div>
      <nav class="foot-col" aria-label={L.explore}>
        <p class="foot-h">{L.explore}</p>
        <ul>{explore.map(([, n, h]) => <li><a href={P(lang, h)}>{n}</a></li>)}</ul>
      </nav>
      <div class="foot-col">
        <p class="foot-h">{t.footer.colContact}</p>
        <ul>
          <li><a href={wa} target="_blank" rel="noopener" dir="ltr" data-evt="whatsapp_click" data-loc="footer">{phoneFmt}</a></li>
          <li><a href={`mailto:${CONFIG.email}`} dir="ltr" data-evt="email_click" data-loc="footer">{CONFIG.email}</a></li>
          <li><span>{t.footer.area}</span></li>
          <li><span class="reply">{t.footer.reply}</span></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {new Date().getFullYear()} {CONFIG.brand} | {CONFIG.tagline}. {t.footer.rights}.</span>
      <span class="built">{t.footer.built}</span>
      <a class="to-top" href="#top">{t.footer.top} <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
<div class="mbar" role="group" aria-label="quick actions">
  <a class="btn btn-primary btn-sm" href={home + '#contact'} data-evt="cta_click" data-loc="mbar">{t.nav.cta}</a>
  <a class="btn btn-wa btn-sm" href={wa} target="_blank" rel="noopener" data-evt="whatsapp_click" data-loc="mbar">{L.chat}</a>
</div>
