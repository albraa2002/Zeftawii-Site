---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Base from '../layouts/Base.astro';
import { T, type Lang } from '../i18n';
import { CONFIG } from '../config';
import { UI, P } from '../content/ui';
import { services } from '../content/services';
interface Props { lang: Lang; title: string; desc: string; path: string; alt: { ar: string; en: string }; extraLd?: object[]; ogType?: string; noindex?: boolean }
const { lang, title, desc, path, alt, extraLd = [], ogType, noindex = false } = Astro.props;
const u = UI[lang]; const t = T[lang];
const wa = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(t.contact.waMsg)}`;
const home = P(lang, '/');
const other = lang === 'ar' ? alt.en : alt.ar;
---
<Base lang={lang} title={title} desc={desc} path={path} alt={alt} inner extraLd={extraLd} ogType={ogType} noindex={noindex}>
  <a class="skip" href="#main">{u.skip}</a>
  <Header lang={lang} alt={other} />
  <main id="main" class="inner">
    <slot />
  </main>
  <Footer lang={lang} />
  <a class="wa-float" href={wa} target="_blank" rel="noopener" aria-label={t.contact.wa} data-evt="whatsapp_click" data-loc="float_inner">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.2c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.4-3.9-4.5-4.1-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9.9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.200 1 2.200 1.400 2.500 1.500.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.3.7-.2l1.900.9c.3.1.5.2.6.3.1.2.1.8-.1 1.400Z"/></svg>
  </a>
  <script>
    const trk = (n: string, p: Record<string, unknown> = {}) => { const g = (window as any).gtag; if (typeof g === 'function') g('event', n, p); };
    document.addEventListener('click', (e) => { const el = (e.target as Element).closest<HTMLElement>('[data-evt]'); if (el) trk(el.dataset.evt!, { location: el.dataset.loc }); });
  </script>
</Base>
