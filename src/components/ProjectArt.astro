---
// بنر لكل مشروع: لوحة داخل إطار متصفح، مرسومة بـ SVG من أرقام البيانات التجريبية الفعلية في الريبو.
import type { ProjectKind } from '../content/projects';
import D from '../content/data/projects-data.json';
const { kind, lang = 'ar', name = '' } = Astro.props as { kind: ProjectKind; lang?: 'ar' | 'en'; name?: string };
const ar = lang === 'ar';
const L = (a: string, e: string) => (ar ? a : e);
const chip = kind === 'arsenal' ? L('مشروع تعلّم', 'Learning project') : kind === 'saas' ? L('مفهوم عرض', 'Display concept') : L('بيانات محاكاة', 'Simulated data');
const segCol: Record<string, string> = { Champion: '#34d399', Loyal: '#4c9bff', New: '#a78bfa', Lost: '#8c97aa', 'At-Risk VIP': '#f87171' };
const seg = Object.entries(D.rfm.seg) as [string, number][];
const segMax = Math.max(...seg.map((x) => x[1]));
const tv = D.tv; const rto = D.rto;
const rtoT = rto.total_orders;
const g = kind;
// نقاط الـ scatter للمراجحة (حتمية)
const pts = Array.from({ length: 34 }, (_, i) => { const s = Math.sin(i * 12.9898) * 43758.5453; const r = s - Math.floor(s); const x = 30 + (i / 33) * 440; const dev = (r - 0.5) * 70; const hot = i % 7 === 3; return { x, y: 170 - (x - 30) * 0.28 + dev + (hot ? 42 : 0), hot }; });
const kp = {
  rto: [[L('أوردرات', 'Orders'), String(rtoT)], [L('موقوفة', 'Halted'), String(rto.halted_count)], [L('شحن موفّر', 'Shipping saved'), '$' + rto.total_saved_usd]],
  rfm: [[L('عملاء', 'Customers'), String(D.rfm.n)], ['At-Risk VIP', String(D.rfm.seg['At-Risk VIP'])], [L('إنفاق الخطر', 'At risk'), String(D.rfm.rev['At-Risk VIP'].toLocaleString('en-US'))]],
  vampire: [[L('عملاء', 'Clients'), String(tv.n)], [L('بينزفوا', 'Bleeding'), String(tv.status.Bleeding)], [L('ساعات زيادة', 'Overage hrs'), String(tv.over)]],
  guillotine: [[L('عملاء', 'Clients'), '500'], [L('نموذج', 'Model'), 'RF'], ['API', 'FastAPI']],
  arbitrage: [[L('عربيات', 'Cars'), '5,000'], [L('حد الصفقة', 'Deal gap'), '15%'], ['API', 'FastAPI']],
  arsenal: [[L('صفحات', 'Pages'), '6'], [L('مصادر', 'Sources'), '5+'], [L('تصدير', 'Export'), 'PBI']],
  saas: [['MRR', '–'], ['Churn', '–'], ['LTV', '–']],
}[g];
const guil = [78, 64, 51, 33, 18, -9, -24, -41];
---
<div class="pa" role="img" aria-label={`${name} (${chip})`}>
  <div class="pa-chrome" dir="ltr"><i></i><i></i><i></i><span>{name}</span><em>{chip}</em></div>
  <div class="pa-body" dir={ar ? 'rtl' : 'ltr'}>
    <div class="pa-kpis">{kp.map((k, i) => <div class={`pa-k pa-k${i}`}><small>{k[0]}</small><b>{k[1]}</b></div>)}</div>
    <svg viewBox={g === "rto" ? "0 0 500 196" : "0 0 500 220"} class="pa-svg" aria-hidden="true" dir="ltr" style="direction:ltr;unicode-bidi:isolate">
      {g === 'rfm' && seg.map(([n, v], i) => (
        <g><rect x="150" y={8 + i * 42} width={(v / segMax) * 300} height="30" rx="7" fill={segCol[n]} opacity=".9" />
        <text x="140" y={30 + i * 42} text-anchor="end" font-size="19" fill="currentColor">{n}</text>
        <text x={160 + (v / segMax) * 300} y={30 + i * 42} font-size="19" font-weight="700" fill="currentColor">{v}</text></g>
      ))}
      {g === 'vampire' && tv.top.map((c, i) => (
        <g><rect x="20" y={12 + i * 25} width="440" height="16" rx="8" fill="currentColor" opacity=".08" />
        <rect x="20" y={12 + i * 25} width={Math.min(c.p, 140) / 140 * 440} height="16" rx="8" fill={c.s === 'Bleeding' ? '#f87171' : c.s === 'Warning' ? '#f59e0b' : '#34d399'} />
        <text x={Math.min(c.p, 140) / 140 * 440 - 8} y={25 + i * 25} text-anchor="end" font-size="14" font-weight="700" fill="#fff">{c.p}%</text></g>
      ))}
      {g === 'rto' && (<g>
        <rect x="20" y="30" width={rto.approved_count / rtoT * 460} height="56" rx="8" fill="#34d399" />
        <rect x={20 + rto.approved_count / rtoT * 460} y="30" width={rto.review_count / rtoT * 460} height="56" fill="#f59e0b" />
        <rect x={20 + (rto.approved_count + rto.review_count) / rtoT * 460} y="30" width={rto.halted_count / rtoT * 460} height="56" rx="8" fill="#f87171" />
        <text x={20 + rto.approved_count / rtoT * 230} y="66" text-anchor="middle" font-size="24" font-weight="800" fill="#06101f">{rto.approved_count}</text>
        <text x={20 + (rto.approved_count + rto.review_count / 2) / rtoT * 460} y="66" text-anchor="middle" font-size="24" font-weight="800" fill="#06101f">{rto.review_count}</text>
        <text x={20 + (rto.approved_count + rto.review_count + rto.halted_count / 2) / rtoT * 460} y="66" text-anchor="middle" font-size="24" font-weight="800" fill="#06101f">{rto.halted_count}</text>
        <path d="M20 180 L90 160 L160 166 L230 138 L300 146 L370 118 L440 124 L480 104" fill="none" stroke="#4c9bff" stroke-width="3" /></g>)}
      {g === 'guillotine' && guil.map((v, i) => (
        <g><rect x={v >= 0 ? 250 : 250 + v * 2.8} y={12 + i * 25} width={Math.abs(v) * 2.8} height="17" rx="5" fill={v >= 0 ? '#34d399' : '#f87171'} /></g>
      ))}
      {g === 'guillotine' && <line x1="250" y1="6" x2="250" y2="214" stroke="currentColor" opacity=".35" />}
      {g === 'arbitrage' && (<g>
        <line x1="30" y1="170" x2="470" y2="47" stroke="#4c9bff" stroke-width="2.5" stroke-dasharray="5 4" />
        {pts.map((p) => <circle cx={p.x} cy={Math.max(14, Math.min(205, p.y))} r={p.hot ? 6 : 4} fill={p.hot ? '#34d399' : 'currentColor'} opacity={p.hot ? 1 : .35} />)}</g>)}
      {g === 'arsenal' && (<g fill="none" stroke="currentColor" stroke-opacity=".5" stroke-width="2">
        <rect x="40" y="16" width="420" height="188" rx="6" /><line x1="250" y1="16" x2="250" y2="204" /><circle cx="250" cy="110" r="34" />
        <rect x="40" y="62" width="62" height="96" /><rect x="398" y="62" width="62" height="96" />
        <path d="M110 150 Q190 60 280 100 T420 70" stroke="#f87171" stroke-opacity="1" stroke-width="3" /><circle cx="420" cy="70" r="6" fill="#f87171" stroke="none" /></g>)}
      {g === 'saas' && (<g>
        <path d="M20 180 L90 160 L160 150 L230 120 L300 110 L370 80 L440 60 L480 40 L480 205 L20 205 Z" fill="#4c9bff" opacity=".18" />
        <path d="M20 180 L90 160 L160 150 L230 120 L300 110 L370 80 L440 60 L480 40" fill="none" stroke="#4c9bff" stroke-width="3" />
        <path d="M20 150 L90 155 L160 140 L230 150 L300 130 L370 135 L440 120 L480 118" fill="none" stroke="#a78bfa" stroke-width="2.5" stroke-dasharray="6 4" /></g>)}
    </svg>
    {g === 'rto' && <ul class="pa-leg"><li><i style="background:#34d399"></i>{L('موافقة', 'Approved')}</li><li><i style="background:#f59e0b"></i>{L('مراجعة', 'Review')}</li><li><i style="background:#f87171"></i>{L('إيقاف', 'Halt')}</li></ul>}
  </div>
</div>
