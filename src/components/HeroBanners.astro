---
// 4 بنرات للهيرو: تكوين واحد لكل بنر، نص قليل + رسمة كبيرة. نفس الخطوط (IBM Plex Sans Arabic / Inter).
import type { Lang } from '../i18n';
import { P } from '../content/ui';
import { CONFIG } from '../config';
import { quotes } from '../content/testimonials';
import { certCount } from '../content/certs';
import { projects } from '../content/projects';
const { lang, t } = Astro.props as { lang: Lang; t: any };
const ar = lang === 'ar'; const L = (a: string, e: string) => (ar ? a : e);
// نقاط "ضجيج" بتتحول لإشارة (حتمية)
const dots = Array.from({ length: 70 }, (_, i) => { const a = Math.sin(i * 91.7) * 43758.5453, b = Math.sin(i * 12.9 + 3) * 24634.6345; const r1 = a - Math.floor(a), r2 = b - Math.floor(b); const k = i / 69; const x = 20 + k * 470; const line = 300 - k * k * 220 - k * 40; const spread = (1 - k) * 120 + 6; return { x, y: Math.max(20, Math.min(330, line + (r2 - 0.5) * 2 * spread)), r: 2 + r1 * 2.2, k }; });
const line = Array.from({ length: 12 }, (_, i) => { const k = i / 11; return `${20 + k * 470},${300 - k * k * 220 - k * 40}`; }).join(' ');
const tiles = projects.map((p, i) => ({ n: p.en.name.replace('Arsenal Analytics Platform', 'Arsenal Analytics').replace('SaaS Executive Dashboard', 'SaaS Exec Board').replace('Auto-Arbitrage Sentinel', 'Auto-Arbitrage').replace('Time-Vampire Matrix', 'Time-Vampire').replace('RFM Profit Radar', 'RFM Radar'), s: p.slug, x: (i % 3) * 178, y: Math.floor(i / 3) * 106, w: i === 6 ? 520 : 164, nb: i === 6 ? 20 : 6 }));
const q = quotes[2]; const roles = [quotes[0], quotes[1], quotes[2]].map((x) => x.role[lang]);
---
<div class="hb hb1 hs-slide on" role="group" aria-roledescription="slide" aria-label="1 / 4">
  <div class="hb-text">
    <span class="hb-k">{t.hero.kicker}</span>
    <h1>{t.hero.h1a}<span class="grad">{t.hero.h1b}</span></h1>
    <p>{t.hero.sub}</p>
    <div class="cta-row"><a class="btn btn-primary" href="#contact" data-evt="cta_click" data-loc="hero">{t.hero.primary}</a><a class="btn hb-ghost" href="#services">{t.hero.secondary}</a></div>
  </div>
  <svg class="hbx" style="direction:ltr" viewBox="0 0 520 360" aria-hidden="true" dir="ltr">
    <defs><linearGradient id="hbg1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4c9bff" stop-opacity=".35" /><stop offset="1" stop-color="#4c9bff" stop-opacity="0" /></linearGradient></defs>
    {[80, 160, 240, 320].map((y) => <line x1="10" x2="510" y1={y} y2={y} stroke="#fff" stroke-opacity=".07" />)}
    <polygon points={`${line} 490,340 20,340`} fill="url(#hbg1)" />
    {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill={d.k > .75 ? '#4c9bff' : '#fff'} opacity={d.k > .75 ? .95 : .15 + d.k * .5} />)}
    <polyline points={line} fill="none" stroke="#4c9bff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="490" cy="80" r="9" fill="#0b0e14" stroke="#4c9bff" stroke-width="4" /><circle cx="490" cy="80" r="22" fill="none" stroke="#4c9bff" stroke-opacity=".35" />
    <text x="474" y="52" text-anchor="end" font-size="15" font-weight="700" fill="#e9edf5" font-family="Inter, sans-serif">{L('Decision', 'Decision')}</text>
    <text x="22" y="352" font-size="12" fill="#8c97aa" font-family="IBM Plex Mono, monospace">{L('RAW DATA', 'RAW DATA')}</text>
  </svg>
</div>
<div class="hb hb2 hs-slide" role="group" aria-roledescription="slide" aria-label="2 / 4" aria-hidden="true">
  <div class="hb-text">
    <span class="hb-k">{L('مشاريع على GitHub', 'Projects on GitHub')}</span>
    <h2>{L('سبعة مشاريع، كل واحد بيحل مشكلة', 'Seven projects, each solving one problem')}</h2>
    <p>{L('بنيتها بنفسي لاختبار أفكار تحليلية حقيقية. المشكلة والطريقة والمخرجات، ومكتوب بوضوح لما البيانات تجريبية.', 'Built by me to test real analytical ideas. The problem, the method and the outputs, with simulated data labelled clearly.')}</p>
    <div class="cta-row"><a class="btn btn-primary" href={P(lang, '/projects/')}>{L('شوف المشاريع', 'See the projects')}</a><a class="btn hb-ghost" href={CONFIG.links.github} target="_blank" rel="noopener noreferrer me">GitHub</a></div>
  </div>
  <svg class="hbx" style="direction:ltr" viewBox="0 0 520 330" aria-hidden="true" dir="ltr">
    {tiles.map((x, i) => { const c = ['#34d399', '#4c9bff', '#f59e0b', '#f87171', '#a78bfa', '#34d399', '#4c9bff'][i]; const step = (x.w - 28) / x.nb; return (<g transform={`translate(${x.x},${x.y + 10})`}>
      <rect width={x.w} height="94" rx="12" fill="#151a24" stroke="#fff" stroke-opacity=".12" />
      <rect x="14" y="13" width="8" height="8" rx="2" fill={c} />
      <text x="28" y="21" font-size="11.5" font-weight="700" fill="#e9edf5" font-family="Inter, sans-serif">{x.n}</text>
      {Array.from({ length: x.nb }, (_, b) => { const h = 12 + ((i * 7 + b * 11) % 30) * (x.w > 300 ? 1.1 : 1); return <rect x={14 + b * step + step * 0.12} y={84 - h} width={step * 0.76} height={h} rx="3" fill={c} opacity={.35 + (b / x.nb) * .6} />; })}
    </g>); })}
  </svg>
</div>
<div class="hb hb3 hs-slide" role="group" aria-roledescription="slide" aria-label="3 / 4" aria-hidden="true">
  <div class="hb-text">
    <span class="hb-k">{L('آراء حقيقية', 'Real feedback')}</span>
    <h2>{L(`${quotes.length} رأي من اللي اشتغلوا معايا`, `${quotes.length} opinions from people I worked with`)}</h2>
    <p>{L('من رسائل عملاء وتوصيات منشورة علنًا على LinkedIn، منسوبة بالدور فقط.', 'From client messages and public LinkedIn recommendations, credited by role only.')}</p>
    <div class="cta-row"><a class="btn btn-primary" href="#voices">{L('اقرأ الآراء', 'Read the feedback')}</a><a class="btn hb-ghost" href={P(lang, '/certificates/')}>{L('الشهادات', 'Certificates')}</a></div>
  </div>
  <figure class="hb-quote"><span class="hb-qm" aria-hidden="true">“</span><blockquote>{q[lang]}</blockquote><figcaption>{q.role[lang]}</figcaption><ul class="hb-roles">{roles.map((r) => <li>{r}</li>)}</ul></figure>
</div>
<div class="hb hb4 hs-slide" role="group" aria-roledescription="slide" aria-label="4 / 4" aria-hidden="true">
  <div class="hb-text">
    <span class="hb-k">{L('من أنا', 'About me')}</span>
    <h2>{L('من المعلوماتية الطبية لتحليل البيانات', 'From medical informatics to data analytics')}</h2>
    <p>{L('خريج جامعة المنصورة، وشغال من 2023 مع عملاء في مصر والسعودية. اعرف مين اللي هيشتغل على بياناتك.', 'A Mansoura University graduate, working since 2023 with clients in Egypt and Saudi Arabia. Meet the person who will work on your data.')}</p>
    <div class="cta-row"><a class="btn btn-primary" href={P(lang, '/about/')}>{L('اعرف أكتر عني', 'Read my story')}</a><a class="btn hb-ghost" href={P(lang, '/certificates/')}>{L('الشهادات', 'Certificates')}</a></div>
  </div>
  <div class="hb-me">
    <img src="/albaraa.jpg" width="640" height="640" alt={L('البراء إيهاب الزفتاوي', 'Albaraa Ehab Elzeftawy')} loading="lazy" decoding="async" />
    <ul><li><b>2026</b>{L('تخرج', 'Graduated')}</li><li><b>2023</b>{L('بداية الشغل', 'Working since')}</li><li><b>{certCount}</b>{L('شهادة', 'Certificates')}</li></ul>
  </div>
</div>
