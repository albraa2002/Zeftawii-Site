---
import Shell from './Shell.astro';
import type { Lang } from '../i18n';
import { UI, P } from '../content/ui';
import { about } from '../content/site';
import { services } from '../content/services';
import { CONFIG } from '../config';
import { story } from '../content/story';
import { certCount } from '../content/certs';
import Testimonials from './Testimonials.astro';
const { lang } = Astro.props as { lang: Lang };
const st = story[lang]; const a = about[lang]; const u = UI[lang]; const base = CONFIG.site.replace(/\/$/, '');
const path = P(lang, '/about/');
const wa = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(lang === 'ar' ? 'أهلاً، قرأت صفحة عنّك وحابب أتكلم عن شغلي.' : 'Hi, I read your about page and would like to talk about my business.')}`;
const ld = [{ '@type': 'AboutPage', name: a.title, url: base + path, inLanguage: lang, mainEntity: { '@id': `${base}/#person` } }];
---
<Shell lang={lang} title={a.title} desc={a.desc} path={path} alt={{ ar: '/about/', en: '/en/about/' }} extraLd={ld}>
  <div class="wrap about-hero">
    <img class="about-img" src="/albaraa.jpg" srcset="/albaraa-320.jpg 320w, /albaraa.jpg 640w" sizes="200px" width="640" height="640" alt={lang === 'ar' ? 'البراء إيهاب الزفتاوي' : 'Albaraa Ehab Elzeftawy'} decoding="async" />
    <div class="page-head">
      <nav class="crumbs" aria-label="breadcrumb"><a href={P(lang, '/')}>{u.crumbHome}</a> <span>/</span> <span>{u.about}</span></nav>
      <h1>{a.h1}</h1>
      <p>{a.lead}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={P(lang, '/#contact')} data-evt="cta_click" data-loc="about">{a.ctaBtn}</a>
        <a class="btn btn-wa" href={wa} target="_blank" rel="noopener" data-evt="whatsapp_click" data-loc="about">{u.wa}</a>
      </div>
    </div>
  </div>
  <div class="wrap">
    <h2 class="sec-h">{st.factsT}</h2>
    <div class="facts">{st.facts.map((f) => <div><b>{f.v}</b><span>{f.l}</span></div>)}</div>
    <h2 class="sec-h">{st.tlT}</h2>
    <ol class="timeline">{st.tl.map((x) => <li><time>{x.t}</time><h3>{x.h}</h3><p>{x.p}</p></li>)}</ol>
    <div class="stats-row">{a.nums.map((n) => <div class="stat"><b>{n.v}</b><span>{n.l}</span></div>)}</div>
    <div class="two-col">
      <section class="info-box"><h2>{st.courseT}</h2><p class="plain">{st.courseP}</p><div class="chips-row">{st.courses.map((c) => <span class="chip">{c}</span>)}</div></section>
      <section class="info-box good"><h2>{st.whyT}</h2><ul>{st.why.map((c) => <li>{c}</li>)}</ul></section>
    </div>
    <h2 class="sec-h">{a.doT}</h2>
    <div class="chips-row">{services.map((s) => <a class="chip-link" href={P(lang, `/services/${s.slug}/`)}>{s[lang].name}</a>)}</div>
    <div class="two-col">
      <section class="info-box"><h2>{a.howT}</h2><ul>{a.how.map((x) => <li>{x}</li>)}</ul></section>
      <section class="info-box good"><h2>{a.toolsT}</h2><ul>{a.tools.map((x) => <li>{x}</li>)}</ul></section>
    </div>
    <h2 class="sec-h">{lang === 'ar' ? 'شهادات ودورات' : 'Certificates and courses'}</h2>
    <div class="cta-box" style="margin-top:0"><p class="plain">{lang === 'ar' ? `${certCount} شهادة ودورة في تحليل البيانات وإدارة المشاريع والتسويق، من Udemy وDataCamp وhp LIFE وغيرها.` : `${certCount} certificates and courses in data analytics, project management and marketing, from Udemy, DataCamp, hp LIFE and others.`}</p><div class="cta-row"><a class="btn btn-ghost" href={P(lang, '/certificates/')}>{lang === 'ar' ? 'شوف كل الشهادات' : 'See all certificates'}</a><a class="btn btn-ghost" href={P(lang, '/projects/')}>{lang === 'ar' ? 'المشاريع' : 'Projects'}</a></div></div>
    <h2 class="sec-h">{lang === 'ar' ? 'آراء الناس في الشغل' : 'What people say'}</h2>
    <p class="plain">{lang === 'ar' ? 'اقتباسات حقيقية من رسائل عملاء وتوصيات منشورة علنًا على LinkedIn، منسوبة بالدور فقط.' : 'Real quotes from client messages and public LinkedIn recommendations, credited by role only.'}</p>
    <Testimonials lang={lang} />
    <div class="cta-box"><h2>{a.ctaT}</h2><p>{a.ctaP}</p>
      <div class="cta-row"><a class="btn btn-primary" href={P(lang, '/#contact')}>{a.ctaBtn}</a><a class="btn btn-ghost" href={P(lang, '/work/')}>{u.allWork}</a></div>
    </div>
  </div>
</Shell>
