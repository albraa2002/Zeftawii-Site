---
import Shell from './Shell.astro';
import Illus from './Illus.astro';
import PromoBanner from './PromoBanner.astro';
import type { Lang } from '../i18n';
import { UI, P } from '../content/ui';
import { posts } from '../content/posts';
import { services } from '../content/services';
import { CONFIG } from '../config';
const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const post = posts.find((p) => p.slug === slug)!; const c = post[lang]; const u = UI[lang];
const base = CONFIG.site.replace(/\/$/, '');
const path = P(lang, `/blog/${slug}/`);
const svc = services.find((s) => s.idx === post.svc);
const more = posts.filter((p) => p.slug !== slug).slice(0, 3);
const wa = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent((lang === 'ar' ? 'أهلاً، قرأت مقال "' : 'Hi, I read the article "') + c.title + (lang === 'ar' ? '" وحابب أستشير.' : '" and would like advice.'))}`;
const ld = [
  { '@type': 'BlogPosting', headline: c.title, description: c.desc, inLanguage: lang, datePublished: post.date, dateModified: post.date, url: base + path, mainEntityOfPage: base + path, image: `${base}/og-image.png`, author: { '@id': `${base}/#person` }, publisher: { '@id': `${base}/#person` } },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: u.crumbHome, item: base + P(lang, '/') },
    { '@type': 'ListItem', position: 2, name: u.blog, item: base + P(lang, '/blog/') },
    { '@type': 'ListItem', position: 3, name: c.title, item: base + path },
  ] },
];
---
<Shell lang={lang} title={`${c.title} | Zeftawii`} desc={c.desc} path={path} alt={{ ar: `/blog/${slug}/`, en: `/en/blog/${slug}/` }} extraLd={ld} ogType="article">
  <article class="wrap article">
    <nav class="crumbs" aria-label="breadcrumb"><a href={P(lang, '/')}>{u.crumbHome}</a> <span>/</span> <a href={P(lang, '/blog/')}>{u.blog}</a></nav>
    <h1>{c.title}</h1>
    <p class="meta">{u.by} · {post.date} · {post.mins} {u.min}</p>
    <div class="art-banner"><Illus kind={['bi', 'marketing', 'automation', 'ai', 'account', 'project'][post.svc] || 'blog'} /></div>
    <div class="tldr"><b>{u.tldr}</b><p>{c.tldr}</p></div>
    <div class="prose">
      {c.body.map((b) => b.h ? <h2>{b.h}</h2> : b.p ? <p>{b.p}</p> : b.ul ? <ul>{b.ul.map((x) => <li>{x}</li>)}</ul> : null)}
    </div>
    <PromoBanner lang={lang} kind="tools" />
    <p class="art-note">{u.note}</p>
    <div class="cta-box">
      <h2>{u.ctaT}</h2><p>{u.ctaP}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={P(lang, `/?service=${post.svc}#contact`)} data-evt="cta_click" data-loc="blog_post">{u.ctaBtn}</a>
        <a class="btn btn-wa" href={wa} target="_blank" rel="noopener" data-evt="whatsapp_click" data-loc="blog_post">{u.wa}</a>
      </div>
    </div>
    {svc && <p class="rel-svc">{u.relatedSvc}: <a href={P(lang, `/services/${svc.slug}/`)}>{svc[lang].name}</a></p>}
    <h2 class="rel-h">{u.related}</h2>
    <div class="post-grid tight">
      {more.map((p) => (
        <a class="post-card" href={P(lang, `/blog/${p.slug}/`)}><h3>{p[lang].title}</h3><span class="more">{u.read} <i aria-hidden="true">{lang === 'ar' ? '←' : '→'}</i></span></a>
      ))}
    </div>
  </article>
</Shell>
