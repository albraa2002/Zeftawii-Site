---
import Shell from './Shell.astro';
import type { Lang } from '../i18n';
import { UI, P } from '../content/ui';
import { posts } from '../content/posts';
import { services } from '../content/services';
import { CONFIG } from '../config';
const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const s = services.find((x) => x.slug === slug)!; const c = s[lang]; const u = UI[lang];
const base = CONFIG.site.replace(/\/$/, '');
const path = P(lang, `/services/${slug}/`);
const rel = posts.filter((p) => s.posts.includes(p.slug));
const others = services.filter((x) => x.slug !== slug);
const steps = u.howSteps.split('|');
const wa = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent((lang === 'ar' ? 'أهلاً، حابب أستفسر عن خدمة: ' : 'Hi, I would like to ask about: ') + c.name)}`;
const ld = [
  { '@type': 'Service', name: c.name, description: c.desc, url: base + path, inLanguage: lang, provider: { '@id': `${base}/#person` }, areaServed: ['SA', 'EG'] },
  { '@type': 'FAQPage', mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: u.crumbHome, item: base + P(lang, '/') },
    { '@type': 'ListItem', position: 2, name: u.services, item: base + P(lang, '/#services') },
    { '@type': 'ListItem', position: 3, name: c.name, item: base + path },
  ] },
];
---
<Shell lang={lang} title={`${c.h1} | Zeftawii`} desc={c.desc} path={path} alt={{ ar: `/services/${slug}/`, en: `/en/services/${slug}/` }} extraLd={ld}>
  <div class="wrap page-head">
    <nav class="crumbs" aria-label="breadcrumb"><a href={P(lang, '/')}>{u.crumbHome}</a> <span>/</span> <a href={P(lang, '/#services')}>{u.services}</a></nav>
    <span class="kicker">{c.name}</span>
    <h1>{c.h1}</h1>
    <p>{c.lead}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href={P(lang, `/?service=${s.idx}#contact`)} data-evt="cta_click" data-loc="service_page">{u.ctaBtn}</a>
      <a class="btn btn-wa" href={wa} target="_blank" rel="noopener" data-evt="whatsapp_click" data-loc="service_page">{u.wa}</a>
    </div>
    <p class="free">{u.free}</p>
  </div>
  <div class="wrap two-col">
    <section class="info-box"><h2>{u.forWho}</h2><ul>{c.forWho.map((x) => <li>{x}</li>)}</ul></section>
    <section class="info-box good"><h2>{u.get}</h2><ul>{c.get.map((x) => <li>{x}</li>)}</ul></section>
  </div>
  <div class="wrap">
    <h2 class="sec-h">{u.how}</h2>
    <ol class="how">{steps.map((x, i) => <li><b>{i + 1}</b><span>{x}</span></li>)}</ol>
    <h2 class="sec-h">{u.faq}</h2>
    <div class="faq-list">{c.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    {rel.length > 0 && (<>
      <h2 class="sec-h">{u.related}</h2>
      <div class="post-grid tight">{rel.map((p) => <a class="post-card" href={P(lang, `/blog/${p.slug}/`)}><h3>{p[lang].title}</h3><span class="more">{u.read} <i aria-hidden="true">{lang === 'ar' ? '←' : '→'}</i></span></a>)}</div>
    </>)}
    <h2 class="sec-h">{u.moreSvc}</h2>
    <div class="chips-row">{others.map((o) => <a class="chip-link" href={P(lang, `/services/${o.slug}/`)}>{o[lang].name}</a>)}</div>
  </div>
</Shell>
